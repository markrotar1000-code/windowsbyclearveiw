---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import { site } from '../../../data/site';
---
<InternalLayout title="Invoice">
  <div class="invoice-toolbar" data-toolbar hidden>
    <div>
      <p class="kicker">Accounts</p>
      <h1>Invoice</h1>
      <p class="lede" data-subtitle>—</p>
    </div>
    <div class="invoice-actions">
      <a class="btn btn-ghost" href="/internal/quotes">All quotes</a>
      <a class="btn btn-ghost" data-quote-link href="#">View quote</a>
      <button class="btn btn-ghost" type="button" data-print>Print</button>
      <a class="btn btn-ghost" data-pdf href="#">Download PDF</a>
      <button class="btn btn-ghost" type="button" data-share>Prepare PDF to share</button>
      <button class="btn btn-primary" type="button" data-email disabled>Email invoice</button>
    </div>
  </div>

  <p class="invoice-status" data-status hidden></p>
  <p class="invoice-error" data-error hidden role="alert"></p>
  <p data-loading>Loading invoice…</p>

  <details class="invoice-settings no-print"><summary>Due date, payment instructions &amp; corrections</summary>
    <div class="settings-grid"><label>Agreed due date (optional)<input type="date" data-due-date /></label><label>Payment instructions (optional)<textarea data-instructions maxlength="2000"></textarea></label></div>
    <button class="btn btn-ghost" type="button" data-save-details>Save invoice details</button>
    <p>Credits and voids preserve the original invoice and record the reason. A credit may leave a customer refund to reconcile.</p>
    <label>Correction reason<input data-correction-reason maxlength="1000" /></label><label>Credit amount ($)<input data-credit-amount type="number" min="0.01" step="0.01" /></label>
    <button class="btn btn-ghost" type="button" data-reconcile hidden>Reconcile replacement invoice</button>
    <button class="btn btn-ghost" type="button" data-credit>Add credit</button><button class="btn btn-ghost" type="button" data-void>Void unpaid invoice</button>
    <h3>Correction history</h3><ol data-adjustments></ol><h3>Delivery history</h3><ol data-deliveries></ol>
  </details>
  <article class="invoice-sheet" data-sheet hidden>
    <header class="invoice-head">
      <div>
        <p class="invoice-kicker">INVOICE</p>
        <h2 data-number>—</h2>
        <p class="invoice-muted" data-issued>—</p>
      </div>
      <div class="invoice-company">
        <img src="/logo/lockup-on-white.png?v=20261028" width="180" alt="ClearView Windows and Trim" /><strong>Clearview Windows</strong>
        <span>{site.legalName}</span>
        <span>{site.phoneDisplay}</span>
        <span>{site.email}</span>
      </div>
    </header>

    <section class="bill-grid">
      <div><p class="label">Bill to</p><strong data-customer>—</strong><span data-address>—</span><span data-email-address>—</span></div>
      <div><p class="label">Source quote</p><span data-source-link>—</span><span>Invoice generated from finalized quote.</span></div>
    </section>

    <section class="invoice-lines">
      <div class="line-head"><span>Description</span><span>Qty</span><span>Unit</span><span>Amount</span></div>
      <div data-lines></div>
    </section>

    <section class="invoice-total">
      <div class="summary"><span>Subtotal</span><strong data-subtotal>—</strong></div>
      <div class="summary" data-discount-row hidden><span data-discount-label>Discount</span><strong data-discount>—</strong></div>
      <div class="summary"><span>Contract total</span><strong data-contract-total>—</strong></div>
      <div class="summary"><span>Credits</span><strong data-credits>—</strong></div>
      <div class="summary"><span>Payments received</span><strong data-payments>—</strong></div>
      <div class="summary grand"><span>Balance due</span><strong data-total>—</strong></div>
    </section>

    <p data-due-copy></p><p data-credit-copy></p>
    <section class="invoice-note">
      <strong>Payment</strong>
      <p data-payment-copy>Payment terms are governed by the signed Clearview agreement. Questions about this invoice can be handled by replying to the invoice email or calling {site.phoneDisplay}.</p>
    </section>

    <footer class="invoice-footer">{site.legalName} · {site.phoneDisplay} · {site.email}</footer>
  </article>
</InternalLayout>

<script>
  import { formatCents } from '../../../lib/money';
  import { fetchJson, esc, SESSION_EXPIRED_MESSAGE } from '../../../lib/internal-fetch';
  import { loadFailedNode, loadFailureMessage } from '../../../lib/load-failed';
  import { workTypeLabel } from '../../../lib/work-type';
  function initInvoiceView() {
    const sheet = document.querySelector('[data-sheet]');
    if (!(sheet instanceof HTMLElement) || sheet.dataset.bound === 'true') return;
    sheet.dataset.bound = 'true';

    const id = new URLSearchParams(location.search).get('id');
    const loading = document.querySelector('[data-loading]');
    const toolbar = document.querySelector('[data-toolbar]');
    const errorEl = document.querySelector('[data-error]');
    const statusEl = document.querySelector('[data-status]');
    const emailBtn = document.querySelector('[data-email]');
    const money = formatCents;

    function fail(message) {
      if (loading instanceof HTMLElement) loading.hidden = true;
      if (errorEl instanceof HTMLElement) { errorEl.hidden = false; errorEl.textContent = message; }
    }

    if (!id) { fail('No invoice id in the URL.'); return; }

    let failed = null;
    let current:any=null;
    let shareFile:File|null=null;
    let sendRequestId:string|null=null;
    async function load() {
      failed?.remove(); failed = null;
      if (loading instanceof HTMLElement) loading.hidden = false;
      try {
        const data = await fetchJson(`/internal/api/invoices/${encodeURIComponent(id)}`, { headers: { 'cache-control': 'no-cache' } });
        current=data.invoice; shareFile=null;
        render(data.invoice, data.items || []);
        renderAdjustments(data.adjustments||[]); const history=document.querySelector('[data-deliveries]');if(history)history.innerHTML=(data.deliveries||[]).map((row:any)=>`<li>${esc(row.created_at)} · ${esc(row.recipient)} · ${esc(row.status||'queued')}</li>`).join('')||'<li>No sends recorded.</li>';
      } catch (e) {
        if (loading instanceof HTMLElement) { loading.hidden = true; failed = loadFailedNode(loadFailureMessage(e), load); loading.after(failed); }
      }
    }

    function render(invoice, items) {
      if (loading instanceof HTMLElement) loading.hidden = true;
      if (toolbar instanceof HTMLElement) toolbar.hidden = false;
      if (sheet instanceof HTMLElement) sheet.hidden = false;
      const set = (s, v) => { const el = sheet.querySelector(s); if (el) el.textContent = v; };
      set('[data-number]', invoice.invoice_number);
      (document.querySelector('[data-reconcile]') as HTMLButtonElement).hidden=!invoice.review_hold;
      // The subtitle lives in the toolbar, outside the sheet, so it is set from the document (it used to be looked up inside the sheet and never filled in).
      const subtitle = document.querySelector('[data-subtitle]');
      if (subtitle) subtitle.textContent = `${invoice.invoice_number} · ${invoice.customer_name} · ${workTypeLabel(invoice.work_type)}`;
      set('[data-issued]', `Issued ${new Date(invoice.created_at).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' })}`);
      set('[data-customer]', invoice.customer_name || '—');
      set('[data-address]', [invoice.customer_address, invoice.customer_city].filter(Boolean).join(', ') || 'Address on file');
      set('[data-email-address]', invoice.customer_email || 'No customer email');
      set('[data-subtotal]', money(invoice.subtotal_cents));
      set('[data-total]', money(invoice.balance_cents ?? invoice.total_cents));
      set('[data-contract-total]',money(invoice.total_cents));set('[data-payments]',money(invoice.amount_paid_cents||0));set('[data-credits]',money(invoice.credited_cents||0));
      set('[data-due-copy]',invoice.due_date?`${invoice.overdue?'Overdue · ':''}Due ${invoice.due_date}`:'');
      set('[data-credit-copy]',invoice.credit_balance_cents?`Customer credit / refund to reconcile: ${money(invoice.credit_balance_cents)}`:'');
      if(invoice.payment_instructions)set('[data-payment-copy]',invoice.payment_instructions);
      (document.querySelector('[data-due-date]') as HTMLInputElement).value=invoice.due_date||'';
      (document.querySelector('[data-instructions]') as HTMLTextAreaElement).value=invoice.payment_instructions||'';
      const pdf=document.querySelector('[data-pdf]') as HTMLAnchorElement;pdf.href=`/internal/api/invoices/${encodeURIComponent(invoice.id)}?format=pdf`;
      (document.querySelector('[data-share]') as HTMLButtonElement).textContent='Prepare PDF to share';
      const discountRow = sheet.querySelector('[data-discount-row]');
      if (Number(invoice.discount_cents || 0) > 0) {
        if (discountRow instanceof HTMLElement) discountRow.hidden = false;
        set('[data-discount-label]', invoice.discount_reason ? `Discount · ${invoice.discount_reason}` : 'Discount');
        set('[data-discount]', `-${money(invoice.discount_cents)}`);
      } else if (discountRow instanceof HTMLElement) discountRow.hidden = true;

      const source = document.querySelector('[data-source-link]');
      if(source)source.textContent=invoice.quote_id;
      const quoteLink = document.querySelector('[data-quote-link]');
      if (quoteLink instanceof HTMLAnchorElement) quoteLink.href = `/internal/quotes/view?id=${encodeURIComponent(invoice.quote_id)}`;

      const lines = sheet.querySelector('[data-lines]');
      if (lines instanceof HTMLElement) lines.innerHTML = items.length ? items.map((item) => `<div class="line-row"><span><strong>${esc(item.label)}</strong>${item.description ? `<small>${esc(item.description)}</small>` : ''}</span><span>${Number(item.quantity) || 0}</span><span>${money(item.unit_price_cents)}</span><strong>${money(item.line_total_cents)}</strong></div>`).join('') : '<p class="invoice-muted">No line items on this invoice.</p>';

      const sent = invoice.status === 'sent' || invoice.status === 'paid';
      if (statusEl instanceof HTMLElement) {
        statusEl.hidden = false;
        statusEl.classList.toggle('paid', invoice.status === 'paid');
        statusEl.textContent = invoice.status === 'paid'
          ? `Paid ${invoice.paid_at ? new Date(invoice.paid_at).toLocaleString('en-US') : ''}`.trim()
          : invoice.status === 'sent'
            ? `Sent ${invoice.sent_at ? new Date(invoice.sent_at).toLocaleString('en-US') : ''}`.trim()
            : invoice.status === 'draft'
              ? invoice.review_hold||'Draft invoice · finalize the quote before emailing'
              : 'Open invoice';
      }
      if (emailBtn instanceof HTMLButtonElement) { emailBtn.disabled = ['draft','void'].includes(invoice.status) || !invoice.customer_email; emailBtn.textContent = invoice.balance_cents===0&&invoice.status!=='draft'?'Email receipt':sent?'Email invoice again':'Email invoice'; emailBtn.dataset.ready = 'true'; emailBtn.dataset.email = invoice.customer_email || ''; }
      setupEmail(invoice);
    }

    function setupEmail(invoice) {
      const button = document.querySelector('[data-email]');
      if (!(button instanceof HTMLButtonElement) || button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', async () => {
        if (!invoice.customer_email) return;
        invoice=current;
        if (!invoice?.customer_email) return;
        button.disabled = true; button.textContent = 'Sending…';
        if (errorEl instanceof HTMLElement) errorEl.hidden = true;
        try {
          const result = await fetchJson(`/internal/api/invoices/${encodeURIComponent(invoice.id)}`, { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify({ action:'email',requestId:sendRequestId||(sendRequestId=crypto.randomUUID()) }) });
          if (statusEl instanceof HTMLElement) { statusEl.hidden = false; statusEl.textContent = `Accepted for delivery ${new Date(result.sentAt || Date.now()).toLocaleString('en-US')}`; }
          sendRequestId=null;
          button.textContent = 'Email invoice again';
          button.disabled = false;
        } catch (e) {
          if (errorEl instanceof HTMLElement) { errorEl.hidden = false; errorEl.textContent = loadFailureMessage(e); }
          button.textContent = 'Email invoice'; button.disabled = false;
        }
      });
    }

    function renderAdjustments(rows:any[]) { const host=document.querySelector('[data-adjustments]');if(host)host.innerHTML=rows.map(row=>`<li>${esc(row.at)} · ${esc(row.kind)}${row.amount_cents?' · '+money(row.amount_cents):''} · ${esc(row.reason)}</li>`).join(''); }
    async function action(body:any) {if(!current)return;try{await fetchJson(`/internal/api/invoices/${encodeURIComponent(current.id)}`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});await load();if(statusEl instanceof HTMLElement){statusEl.hidden=false;statusEl.textContent='Saved.';}}catch(error){fail(loadFailureMessage(error));}}
    document.querySelector('[data-save-details]')?.addEventListener('click',()=>action({action:'details',dueDate:(document.querySelector('[data-due-date]') as HTMLInputElement).value,paymentInstructions:(document.querySelector('[data-instructions]') as HTMLTextAreaElement).value}));
    document.querySelector('[data-reconcile]')?.addEventListener('click',()=>action({action:'reconcile-revision',reason:(document.querySelector('[data-correction-reason]') as HTMLInputElement).value}));
    for(const kind of ['credit','void'])document.querySelector(`[data-${kind}]`)?.addEventListener('click',()=>{const reason=(document.querySelector('[data-correction-reason]') as HTMLInputElement).value;const amount=Number((document.querySelector('[data-credit-amount]') as HTMLInputElement).value);if(!reason.trim()){fail('Enter the correction reason.');return;}action({action:kind,reason,amountCents:Math.round(amount*100),requestId:crypto.randomUUID()});});
    document.querySelector('[data-share]')?.addEventListener('click',async()=>{if(!current)return;const button=document.querySelector('[data-share]') as HTMLButtonElement;try{if(!shareFile){button.disabled=true;const response=await fetch(`/internal/api/invoices/${encodeURIComponent(current.id)}?format=pdf`);if(response.status===401||response.redirected||response.headers.get('content-type')?.includes('text/html'))throw new Error(SESSION_EXPIRED_MESSAGE);if(!response.ok||!response.headers.get('content-type')?.includes('application/pdf'))throw new Error('Could not prepare invoice PDF.');shareFile=new File([await response.blob()],`${current.invoice_number}.pdf`,{type:'application/pdf'});button.textContent='Share PDF';return;}if(navigator.canShare?.({files:[shareFile]}))await navigator.share({files:[shareFile],title:current.invoice_number});else (document.querySelector('[data-pdf]') as HTMLAnchorElement).click();}catch(error){if((error as Error).name!=='AbortError')fail(loadFailureMessage(error));}finally{button.disabled=false;}});
    const print = document.querySelector('[data-print]');
    if (print instanceof HTMLButtonElement) print.addEventListener('click', () => window.print());
    load();
  }

  initInvoiceView();
  document.addEventListener('astro:page-load', initInvoiceView);
</script>

<style>
.invoice-settings{padding:1rem;border:1px solid var(--line);border-radius:8px;margin:1rem 0}.invoice-settings summary{cursor:pointer;font-weight:650}.invoice-settings label{display:grid;gap:.3rem;margin:.7rem 0}.invoice-settings input,.invoice-settings textarea{width:100%;box-sizing:border-box;font:inherit;padding:.6rem}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.invoice-company img{max-width:100%;height:auto}@media(max-width:600px){.settings-grid{grid-template-columns:1fr}}@media print{.no-print,.invoice-settings{display:none!important} :global(body > :not(.internal-main)){display:none!important} :global(.internal-main > :not(.invoice-sheet)){display:none!important} @page{size:letter;margin:.5in}}

.invoice-toolbar{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-s)}.invoice-actions{display:flex;flex-wrap:wrap;gap:var(--space-xs)}.invoice-status{padding:.65rem .8rem;border-left:3px solid var(--accent);background:var(--accent-wash);color:var(--ink-soft)}.invoice-status.paid{border-left-color:var(--accent-ink);font-weight:650;color:var(--ink)}.invoice-error{padding:.7rem .8rem;border-left:3px solid var(--danger);background:color-mix(in srgb,var(--danger) 8%,transparent);color:var(--ink-soft)}.invoice-sheet{max-width:52rem;margin:var(--space-l) auto 0;padding:clamp(1.4rem,4vw,2.8rem);background:var(--paper-raised);border:1px solid var(--line);box-shadow:var(--shadow-soft)}.invoice-head{display:flex;justify-content:space-between;gap:var(--space-l);padding-bottom:var(--space-l);border-bottom:2px solid var(--ink)}.invoice-kicker,.label{margin:0;text-transform:uppercase;letter-spacing:var(--tracking-label);font-size:var(--step--2);font-weight:700;color:var(--ink-faint)}.invoice-head h2{margin:.3rem 0 0;font-size:var(--step-3)}.invoice-muted{margin:.25rem 0 0;color:var(--ink-soft);font-size:var(--step--1)}.invoice-company{display:grid;justify-items:end;align-content:start;gap:.2rem;text-align:right}.invoice-company strong{font-size:var(--step-0)}.invoice-company span{font-size:var(--step--2);color:var(--ink-soft)}.bill-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-l);padding:var(--space-l) 0}.bill-grid>div{display:grid;gap:.3rem}.bill-grid strong{font-size:var(--step-0)}.bill-grid span{color:var(--ink-soft);font-size:var(--step--1)}.bill-grid a{font-weight:650}.invoice-lines{border-top:1px solid var(--line)}.line-head,:global(.line-row){display:grid;grid-template-columns:minmax(0,1fr) 3rem 6rem 7rem;gap:var(--space-s);align-items:start}.line-head{padding:.65rem 0;border-bottom:1px solid var(--line);font-size:var(--step--2);font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-faint)}.line-head span:nth-child(n+2){text-align:right}:global(.line-row){padding:.9rem 0;border-bottom:1px solid var(--line);font-size:var(--step--1)}:global(.line-row>span:not(:first-child)),:global(.line-row>strong){text-align:right}:global(.line-row span:first-child){display:grid;gap:.2rem}:global(.line-row small){color:var(--ink-soft)}.invoice-total{display:grid;justify-items:end;padding:var(--space-l) 0}.summary{display:grid;grid-template-columns:12rem 8rem;gap:var(--space-m);width:min(100%,26rem);padding:.35rem 0;font-size:var(--step--1)}.summary span{text-align:right;color:var(--ink-soft)}.summary strong{text-align:right}.summary.grand{margin-top:.35rem;padding-top:.8rem;border-top:2px solid var(--ink);font-size:var(--step-1)}.summary.grand span,.summary.grand strong{color:var(--ink)}.invoice-note{padding:var(--space-m);border-left:3px solid var(--accent);background:var(--accent-wash)}.invoice-note p{margin:.35rem 0 0;color:var(--ink-soft);font-size:var(--step--1)}.invoice-footer{margin-top:var(--space-l);padding-top:var(--space-s);border-top:1px solid var(--line);font-size:var(--step--2);color:var(--ink-faint)}
@media(max-width:700px){.invoice-toolbar{align-items:flex-start;flex-direction:column}.invoice-head{flex-direction:column}.invoice-company{justify-items:start;text-align:left}.bill-grid{grid-template-columns:1fr}.line-head,:global(.line-row){grid-template-columns:minmax(0,1fr) 2.5rem 5rem 5.5rem;gap:.35rem}.summary{grid-template-columns:1fr auto;width:100%}}
@media print{.invoice-toolbar,.invoice-status,.invoice-error,.internal-header{display:none}.invoice-sheet{max-width:none;margin:0;border:0;box-shadow:none;padding:0}.invoice-head{padding-top:0}}
</style>
