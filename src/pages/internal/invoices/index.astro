---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import WorkTypeFilter from '../../../components/WorkTypeFilter.astro';
---
<InternalLayout title="Invoices">
  <div class="il-head"><div><p class="kicker">Accounts receivable</p><h1>Invoices</h1><p class="lede">Every invoice created from a quote, with its current delivery state and amount.</p></div><a class="btn btn-ghost" href="/internal/quotes">Quotes</a></div>
  <section class="invoice-command"><div><span>SALES → CASH</span><strong>Prepare the invoice. Finalize before sending.</strong><p class="phone-hide">Draft invoices can be prepared before finalization; only finalized quotes can be sent and remain stable after the quote is locked.</p></div><a href="/internal/payments">Open balances →</a></section>
  <div class="il-filter"><WorkTypeFilter /><label>Find invoice<input type="search" data-search placeholder="Customer, invoice # or city" /></label><label>Status<select data-status-filter><option value="">All statuses</option><option value="outstanding">Outstanding</option><option value="overdue">Overdue</option><option value="draft">Draft</option><option value="open">Open</option><option value="sent">Sent</option><option value="paid">Paid</option><option value="void">Void</option></select></label></div>
  <p data-reminder role="status"></p>
  <p data-loading>Loading…</p><p class="il-error" data-error hidden role="alert"></p><p data-empty hidden>No invoices yet. Start a quote to create one automatically.</p>
  <div class="invoice-list" data-list></div><nav class="invoice-pages" aria-label="Invoice pages"><button class="btn btn-ghost" data-prev type="button">Previous</button><span data-page-label></span><button class="btn btn-ghost" data-next type="button">Next</button></nav>
</InternalLayout>
<script>
  import { formatCents } from '../../../lib/money';
  import { fetchJson, esc } from '../../../lib/internal-fetch';
  import { loadFailedNode, loadFailureMessage } from '../../../lib/load-failed';
  import { bindWorkTypeFilter, workTypeBadge } from '../../../lib/work-type';
  function initInvoiceList(){
    const list=document.querySelector('[data-list]');if(!(list instanceof HTMLElement)||list.dataset.bound==='true')return;list.dataset.bound='true';
    const loading=document.querySelector('[data-loading]'),errorEl=document.querySelector('[data-error]'),emptyEl=document.querySelector('[data-empty]');
    const money=formatCents;const labels:Record<string,string>={draft:'Draft',open:'Open',sent:'Sent',paid:'Paid',void:'Void'};
    let page=1,totalPages=1;let timer;let workType:''|'windows'|'siding'='';let pending:AbortController|null=null;
    async function load(){
      pending?.abort();const request=new AbortController();pending=request;
      if(loading instanceof HTMLElement)loading.hidden=false;if(errorEl instanceof HTMLElement)errorEl.hidden=true;if(emptyEl instanceof HTMLElement)emptyEl.hidden=true;list.innerHTML='';
      try{
        const params=new URLSearchParams({page:String(page)});if(workType)params.set('workType',workType);const term=(document.querySelector('[data-search]') as HTMLInputElement).value.trim(),state=(document.querySelector('[data-status-filter]') as HTMLSelectElement).value;if(term)params.set('search',term);if(state)params.set('status',state);const data=await fetchJson(`/internal/api/invoices?${params}`,{signal:request.signal,headers:{'cache-control':'no-cache'}});if(pending!==request)return;
        page=data.page||page;totalPages=Math.max(1,data.totalPages||1);(document.querySelector('[data-prev]') as HTMLButtonElement).disabled=page<=1;(document.querySelector('[data-next]') as HTMLButtonElement).disabled=page>=totalPages;document.querySelector('[data-page-label]')!.textContent=`Page ${page} of ${totalPages} · ${data.total||0} invoices`;document.querySelector('[data-reminder]')!.textContent=data.reminders?.length?`${data.reminders.length} overdue invoice${data.reminders.length===1?'':'s'} need an internal follow-up. No customer reminders have been sent.`:'';
        if(loading instanceof HTMLElement)loading.hidden=true;
        if(!data.invoices?.length){if(emptyEl instanceof HTMLElement){emptyEl.hidden=false;emptyEl.textContent=workType?`No ${workType} invoices yet.`:'No invoices yet. Start a quote to create one automatically.';}return}
        list.innerHTML=data.invoices.map((invoice:any)=>`<article class="invoice-card"><div class="invoice-main"><div class="invoice-top"><span class="invoice-status invoice-status-${esc(invoice.status)}">${labels[invoice.status]||esc(invoice.status)}</span>${workTypeBadge(invoice.work_type)}<span>${esc(invoice.invoice_number)}</span><time>${new Date(invoice.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time></div><h2>${esc(invoice.customer_name)}</h2><p>${esc([invoice.customer_city,invoice.quote_id].filter(Boolean).join(' · ')||'Linked quote')}</p></div><div class="invoice-value"><strong>${money(invoice.balance_cents??invoice.total_cents)}</strong><span>Balance due · ${invoice.sent_at?`Sent ${new Date(invoice.sent_at).toLocaleDateString('en-US',{month:'short',day:'numeric'})}`:'Not sent'}</span></div><div class="invoice-actions"><a class="btn btn-ghost btn-small" href="/internal/invoices/view?id=${encodeURIComponent(invoice.id)}">Open invoice</a><a class="btn btn-ghost btn-small" href="/internal/quotes/view?id=${encodeURIComponent(invoice.quote_id)}">Source quote</a>${invoice.status==='open'||invoice.status==='sent'?`<a class="btn btn-primary btn-small" href="/internal/invoices/view?id=${encodeURIComponent(invoice.id)}">${invoice.status==='sent'?'Email again':'Send invoice'}</a>`:''}</div></article>`).join('');
      }catch(e){
        if(pending!==request||request.signal.aborted)return;
        if(loading instanceof HTMLElement)loading.hidden=true;list.replaceChildren(loadFailedNode(loadFailureMessage(e),load));
      }
    }
    workType=bindWorkTypeFilter(document,(next)=>{workType=next;page=1;load()});
    document.querySelector('[data-search]')?.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{page=1;load();},250);});document.querySelector('[data-status-filter]')?.addEventListener('change',()=>{page=1;load();});document.querySelector('[data-prev]')?.addEventListener('click',()=>{if(page>1){page--;load();}});document.querySelector('[data-next]')?.addEventListener('click',()=>{if(page<totalPages){page++;load();}});
    load();
  }
  initInvoiceList();document.addEventListener('astro:page-load',initInvoiceList);
</script>
<style>
.il-filter{display:flex;gap:1rem;flex-wrap:wrap}.il-filter label{display:grid;gap:.2rem}.il-filter input,.il-filter select{font:inherit;max-width:100%;padding:.5rem}.invoice-pages{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-top:1rem}
  .il-filter{margin-bottom:var(--space-s)}
  .il-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.invoice-command{display:flex;justify-content:space-between;align-items:center;gap:var(--space-m);padding:1.05rem 1.15rem;margin-bottom:var(--space-s);border-radius:var(--radius-lg);background:var(--ink);color:var(--on-dark);box-shadow:var(--shadow-md)}.invoice-command>div{display:grid;gap:.18rem}.invoice-command span{font-size:.65rem;letter-spacing:.16em;font-weight:800;color:var(--accent-bright)}.invoice-command strong{font-size:var(--step-1)}.invoice-command p{margin:0;color:var(--on-dark-soft);font-size:var(--step--2)}.invoice-command>a{color:var(--on-dark);font-size:var(--step--2);font-weight:750;white-space:nowrap}.invoice-list{display:grid;gap:.65rem}:global(.invoice-card){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;padding:1rem 1.05rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);box-shadow:var(--shadow-sm)}:global(.invoice-top){display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.7rem;color:var(--ink-faint)}:global(.invoice-status){font-weight:850;text-transform:uppercase;letter-spacing:.07em}.invoice-status-open{color:var(--accent-ink)}.invoice-status-sent{color:var(--accent-ink)}.invoice-status-paid{color:var(--accent-ink)}.invoice-status-draft{color:var(--ink-soft)}.invoice-status-void{color:var(--danger)}:global(.invoice-main h2){margin:.35rem 0 .08rem;font-size:var(--step-1)}:global(.invoice-main p){margin:0;color:var(--ink-soft);font-size:var(--step--1)}:global(.invoice-value){display:grid;justify-items:end;align-content:start;gap:.15rem}:global(.invoice-value strong){font-size:1.65rem;line-height:1}:global(.invoice-value span){font-size:.7rem;color:var(--ink-soft)}:global(.invoice-actions){grid-column:1/-1;display:flex;gap:.45rem;flex-wrap:wrap;padding-top:.65rem;border-top:1px solid var(--line)}:global(.btn-small){padding:.45rem .68rem;font-size:var(--step--2)}.il-error{color:var(--danger)}@media(max-width:700px){.il-head,.invoice-command{align-items:flex-start;flex-direction:column}:global(.invoice-card){grid-template-columns:1fr}:global(.invoice-value){justify-items:start}:global(.invoice-actions){grid-column:auto}}@media(max-width:460px){:global(.invoice-actions .btn){flex:1;justify-content:center}}
</style>
