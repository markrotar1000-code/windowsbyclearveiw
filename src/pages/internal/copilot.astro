---
import InternalLayout from '../../layouts/InternalLayout.astro';
---

<InternalLayout title="Operations Copilot">
  <div class="copilot-shell">
    <section class="hero">
      <div><p class="eyebrow">CLEARVIEW INTERNAL</p><h1>Operations Copilot</h1><p class="lede">Ask operational questions. Copilot routes each request through the deterministic ICM layer and keeps business state read-only.</p></div>
      <div class="hero-actions"><a class="back" href="/internal/">Command Center</a><a class="back" href="/internal/leads/analyze">Lead Analyzer</a></div>
    </section>
    <section class="panel" aria-label="Operations Copilot">
      <div id="messages" class="messages" aria-live="polite"><div class="welcome"><strong>Ready.</strong><span>Try “What needs attention today?” or “Analyze the latest lead.”</span><div class="starters" role="group" aria-label="Starter questions"><button type="button" data-starter="What needs attention today?">What needs attention today?</button><button type="button" data-starter="Analyze the latest lead.">Analyze the latest lead</button><button type="button" data-starter="How many quotes are still drafts?">Draft quotes</button></div></div></div>
      <form id="copilot-form"><label for="message">Ask Copilot <span class="hint">Ctrl or Cmd + Enter sends</span></label><div class="composer"><textarea id="message" name="message" maxlength="1000" rows="3" placeholder="Ask about leads, jobs, evidence, procedures, or today's operations…" required></textarea><button type="submit">Send</button></div><p id="status" class="status" role="status"></p></form>
    </section>
  </div>
</InternalLayout>
<style>
.copilot-shell{max-width:1100px;margin:0 auto;padding:3rem 1.25rem 5rem}.hero{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:2rem}.hero-actions{display:flex;gap:.5rem;flex-wrap:wrap}.eyebrow{letter-spacing:.18em;font-size:.72rem;opacity:.7}.hero h1{font-size:clamp(2.2rem,6vw,4.5rem);margin:.3rem 0}.lede{max-width:720px;opacity:.72}.back{color:inherit;text-decoration:none;border:1px solid var(--line);border-radius:999px;padding:.7rem 1rem;white-space:nowrap}.panel{border:1px solid var(--line);border-radius:24px;background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-md)}.messages{min-height:430px;max-height:62vh;overflow:auto;padding:1.25rem}.welcome,:global(.message){display:flex;flex-direction:column;gap:.4rem;padding:1rem 1.1rem;border-radius:16px;margin-bottom:.75rem;background:var(--paper)}:global(.message.user){margin-left:12%;background:color-mix(in srgb,var(--accent) 8%,var(--paper))}:global(.message .meta){font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;opacity:.55}:global(.message p){white-space:pre-wrap;margin:0;line-height:1.55}.composer{display:flex;gap:.75rem;align-items:stretch}.panel form{border-top:1px solid var(--line);padding:1rem}.panel label{display:block;font-size:.8rem;margin-bottom:.45rem;opacity:.75}.panel textarea{flex:1;resize:vertical;min-width:0;border:1px solid var(--line);border-radius:14px;background:var(--paper);color:inherit;padding:.9rem;font:inherit}.panel button{align-self:stretch;border:0;border-radius:14px;padding:0 1.25rem;font-weight:700;cursor:pointer}.status{min-height:1.2em;font-size:.78rem;opacity:.72}:global(.status.error){color:#b33}@media(max-width:700px){.copilot-shell{padding-top:2rem}.hero{align-items:start;flex-direction:column}.composer{flex-direction:column}.panel button{min-height:48px}:global(.message.user){margin-left:0}}
  /* Inside the Command Center layout the shell's own padding doubled the page margins on a phone (30 px against 11 px on every other screen). */
  @media(max-width:680px){.copilot-shell{padding:.25rem 0 1rem}.hint{display:none}}
  .starters{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.5rem}.starters button{min-height:44px;border:1px solid var(--line-strong);border-radius:999px;background:var(--paper-raised);color:var(--ink);padding:.5rem .9rem;font:inherit;font-size:.9rem;cursor:pointer}.starters button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.hint{font-weight:400;opacity:.6;font-size:.8rem;margin-left:.4rem}
</style>
<script>
function bindCopilot(){const form=document.querySelector('#copilot-form');const messages=document.querySelector('#messages');const input=document.querySelector('#message');const status=document.querySelector('#status');if(!(form instanceof HTMLFormElement)||!(messages instanceof HTMLElement)||!(input instanceof HTMLTextAreaElement)||!(status instanceof HTMLElement)||form.dataset.bound==='true')return;form.dataset.bound='true';const history=[];const add=(role,text,meta='')=>{const el=document.createElement('div');el.className=`message ${role}`;if(meta){const m=document.createElement('div');m.className='meta';m.textContent=meta;el.appendChild(m)}const p=document.createElement('p');p.textContent=text;el.appendChild(p);messages.appendChild(el);messages.scrollTop=messages.scrollHeight};input.addEventListener('keydown',event=>{if(event.key==='Enter'&&(event.ctrlKey||event.metaKey)&&!event.isComposing){event.preventDefault();form.requestSubmit()}});document.querySelectorAll('[data-starter]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.starter||'';form.requestSubmit()}));form.addEventListener('submit',async event=>{event.preventDefault();const message=input.value.trim();if(!message)return;add('user',message);const draft=message;input.value='';input.disabled=true;const button=form.querySelector('button');if(button instanceof HTMLButtonElement)button.disabled=true;status.textContent='Thinking…';status.className='status';try{const response=await fetch('/internal/api/copilot',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({message,history})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Copilot request failed.');add('assistant',data.answer||'No response returned.',`${data.route||'advisor'} · ${data.provider||'degraded'}${data.degraded?' · VERIFY':''}`);history.push({role:'user',content:message},{role:'assistant',content:String(data.answer||'')});while(history.length>10)history.shift();status.textContent=data.degraded?'AI is unavailable; verify against the underlying records.':''}catch(error){/* Give the question back: on a weak signal the typed text must not vanish with the failed request. */if(!input.value)input.value=draft;status.textContent=error instanceof Error?error.message:'Request failed.';status.className='status error'}finally{input.disabled=false;if(button instanceof HTMLButtonElement)button.disabled=false;input.focus()}})}document.addEventListener('astro:page-load',bindCopilot);bindCopilot();
</script>
