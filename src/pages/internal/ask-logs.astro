---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Ask activity">
  <div class="al-head">
    <div>
      <p class="kicker">Clearview internal</p>
      <h1>Ask activity</h1>
      <p class="lede">How the /ask chatbot is being used: which tools it reached for, what it could not answer, and where conversations lead. Questions and answers are kept for 30 days with phone numbers, emails, addresses and similar details scrubbed out, then deleted.</p>
    </div>
    <div class="al-actions"><a class="btn btn-ghost" href="/internal/leads">Leads</a><a class="btn btn-ghost" href="/internal/quotes">&larr; Quotes</a></div>
  </div>

  <p data-loading>Loading…</p>
  <div class="al-error" data-error hidden role="alert"><span data-error-text></span> <button class="btn btn-ghost" type="button" data-retry>Try again</button></div>
  <p data-empty hidden>No activity yet.</p>

  <div class="al-summary" data-summary hidden>
    <div><strong data-stat-total></strong><span>questions</span></div>
    <div><strong data-stat-refused></strong><span>couldn't answer</span></div>
    <div><strong data-stat-tools></strong><span>used a tool</span></div>
  </div>

  <div class="al-summary" data-funnel hidden role="group" aria-label="Where conversations lead, last 30 days">
    <div><strong data-f="questions"></strong><span>questions asked</span></div>
    <div><strong data-f="estimate"></strong><span>opened the estimate form</span></div>
    <div><strong data-f="call"></strong><span>tapped call</span></div>
    <div><strong data-f="callbackLeads"></strong><span>sent a call-back request</span></div>
  </div>
  <p class="al-note" data-funnel-note hidden>Last 30 days. Estimate and call taps count once per visit; call-back requests are leads from this page.</p>

  <div class="al-filters" data-filters role="group" aria-label="Show questions" hidden>
    <button type="button" class="filter active" data-filter="all" aria-pressed="true">All</button>
    <button type="button" class="filter" data-filter="refused" aria-pressed="false">Couldn't answer</button>
    <button type="button" class="filter" data-filter="tools" aria-pressed="false">Used a tool</button>
  </div>
  <p class="al-note al-none" data-filter-empty hidden>Nothing matches this filter.</p>
  <div class="al-list" data-list hidden></div>
</InternalLayout>

<script>
  function initAskLogs() {
    const list = document.querySelector('[data-list]');
    if (!(list instanceof HTMLElement) || list.dataset.bound === 'true') return;
    list.dataset.bound = 'true';

    const loading = document.querySelector('[data-loading]');
    const errorEl = document.querySelector('[data-error]');
    const emptyEl = document.querySelector('[data-empty]');
    const summary = document.querySelector('[data-summary]');

    // One malformed row must not blank the whole list.
    function parseList(raw: unknown): any[] {
      try {
        const value = JSON.parse(typeof raw === 'string' && raw ? raw : '[]');
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    }

    function isLegacy(l: any) {
      return l.question === '[redacted]';
    }

    function renderFunnel(funnel: Record<string, number> | undefined) {
      const box = document.querySelector('[data-funnel]');
      const note = document.querySelector('[data-funnel-note]');
      if (!(box instanceof HTMLElement) || !funnel) return;
      const values: Record<string, number> = {
        questions: funnel.conversations,
        estimate: funnel.estimate,
        call: funnel.call,
        callbackLeads: funnel.callbackLeads,
      };
      for (const [key, value] of Object.entries(values)) {
        const el = box.querySelector(`[data-f="${key}"]`);
        if (el) el.textContent = String(value ?? 0);
      }
      box.hidden = false;
      if (note instanceof HTMLElement) note.hidden = false;
    }

    const el = (tag: string, className = '', text = '') => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    };

    // An answer over this many characters starts folded to a few lines, so one long reply does not push the rest off the screen.
    const LONG_ANSWER = 320;
    const LONG_QUESTION = 160;

    function buildCard(l: any): HTMLElement {
      const tools = parseList(l.tools_used);
      const sources = parseList(l.sources);
      const when = new Date(l.created_at);
      const date = Number.isNaN(when.getTime()) ? '' : when.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
      const card = el('article', 'al-card' + (l.refused ? ' al-refused' : ''));
      card.dataset.refused = l.refused ? '1' : '0';
      card.dataset.tools = tools.length ? '1' : '0';

      const meta = el('div', 'al-card-meta');
      if (date) meta.append(el('span', '', date));
      meta.append(el('span', '', String(l.model_used ?? '')));
      for (const tool of tools) meta.append(el('span', 'al-tag', String(tool)));
      if (l.refused) meta.append(el('span', 'al-tag al-tag-refused', 'no answer'));
      card.append(meta);

      if (isLegacy(l)) {
        card.append(el('p', 'al-answer', 'Words not recorded (logged before question storage was turned on).'));
        return card;
      }
      const question = String(l.question ?? '');
      const answer = String(l.answer ?? '');
      const asked = el('p', 'al-question', question);
      const body = el('p', 'al-answer', answer);
      card.append(asked, body);
      if (answer.length > LONG_ANSWER || question.length > LONG_QUESTION) {
        // Fold whichever is long; the one toggle opens both.
        const folded = [question.length > LONG_QUESTION ? asked : null, answer.length > LONG_ANSWER ? body : null].filter((n): n is HTMLElement => Boolean(n));
        for (const n of folded) n.classList.add('al-clamped');
        const toggle = el('button', 'al-more', 'Show the full answer');
        toggle.type = 'button';
        toggle.setAttribute('aria-expanded', 'false');
        toggle.addEventListener('click', () => {
          let open = false;
          for (const n of folded) open = n.classList.toggle('al-clamped') === false;
          toggle.textContent = open ? 'Show less' : 'Show the full answer';
          toggle.setAttribute('aria-expanded', String(open));
        });
        card.append(toggle);
      }
      const named = sources.map((s: any) => ({ title: String(s?.title ?? '').trim(), url: String(s?.url ?? '') })).filter((s: { title: string }) => s.title);
      if (named.length) {
        const line = el('p', 'al-sources', 'Sources: ');
        named.forEach((source: { title: string; url: string }, i: number) => {
          if (i) line.append(', ');
          // Only a path on our own site becomes a link.
          if (/^\/[^/\\]/.test(source.url)) {
            const link = el('a', '', source.title) as HTMLAnchorElement;
            link.href = source.url;
            link.target = '_blank';
            link.rel = 'noopener';
            line.append(link);
          } else {
            line.append(source.title);
          }
        });
        card.append(line);
      }
      return card;
    }

    function wireFilters() {
      const bar = document.querySelector('[data-filters]');
      if (!(bar instanceof HTMLElement)) return;
      bar.hidden = false;
      const none = document.querySelector('[data-filter-empty]');
      bar.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          const mode = button.dataset.filter || 'all';
          bar.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
            const on = b === button;
            b.classList.toggle('active', on);
            b.setAttribute('aria-pressed', String(on));
          });
          let shown = 0;
          list.querySelectorAll<HTMLElement>('.al-card').forEach((card) => {
            const match = mode === 'all' || (mode === 'refused' && card.dataset.refused === '1') || (mode === 'tools' && card.dataset.tools === '1');
            card.hidden = !match;
            if (match) shown += 1;
          });
          if (none instanceof HTMLElement) none.hidden = shown > 0;
        });
      });
    }

    function showError(message: string) {
      if (loading instanceof HTMLElement) loading.hidden = true;
      if (errorEl instanceof HTMLElement) {
        errorEl.hidden = false;
        const text = errorEl.querySelector('[data-error-text]');
        if (text) text.textContent = message;
      }
    }

    async function load() {
      if (errorEl instanceof HTMLElement) errorEl.hidden = true;
      if (loading instanceof HTMLElement) loading.hidden = false;
      try {
        const response = await fetch('/internal/api/ask-logs');
        if (!response.ok) throw new Error();
        const { logs, funnel } = await response.json();
        renderFunnel(funnel);

        if (loading instanceof HTMLElement) loading.hidden = true;
        if (!Array.isArray(logs) || !logs.length) {
          if (emptyEl instanceof HTMLElement) emptyEl.hidden = false;
          return;
        }

        if (summary instanceof HTMLElement) {
          summary.hidden = false;
          const refused = logs.filter((l: any) => l.refused).length;
          const withTools = logs.filter((l: any) => parseList(l.tools_used).length > 0).length;
          const set = (sel: string, v: string) => { const node = summary.querySelector(sel); if (node) node.textContent = v; };
          set('[data-stat-total]', String(logs.length));
          set('[data-stat-refused]', String(refused));
          set('[data-stat-tools]', String(withTools));
        }

        list.hidden = false;
        list.replaceChildren(...logs.map(buildCard));
        wireFilters();
      } catch {
        showError('Could not load ask activity. Check your signal and try again.');
      }
    }

    document.querySelector('[data-retry]')?.addEventListener('click', () => void load());
    load();
  }

  initAskLogs();
  document.addEventListener('astro:page-load', initAskLogs);
</script>

<style>
  .al-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    margin-bottom: var(--space-l);
    gap: var(--space-m);
  }

  .al-actions { display: flex; gap: var(--space-xs); flex-wrap: wrap; }

  .al-error {
    color: var(--danger);
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  .al-filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: var(--space-s); }
  .al-filters .filter { border: 1px solid var(--line); background: var(--paper-raised); color: var(--ink-soft); border-radius: 999px; padding: .45rem .85rem; font: inherit; font-size: var(--step--1); font-weight: 700; cursor: pointer; min-height: 2.75rem; }
  .al-filters .filter.active { background: var(--ink); color: var(--on-dark); border-color: var(--ink); }
  .al-none { margin: 0 0 var(--space-s); }
  :global(.al-card[hidden]) { display: none; }

  .al-summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-bottom: var(--space-l);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  .al-summary > div {
    display: flex;
    flex-direction: column;
  }

  .al-summary strong {
    font-size: var(--step-2);
  }

  .al-summary span {
    font-size: var(--step--2);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .al-note {
    margin: calc(var(--space-m) * -1) 0 var(--space-l);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .al-list {
    display: grid;
    gap: var(--space-s);
  }

  :global(.al-card) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-s) var(--space-m);
  }

  :global(.al-card.al-refused) {
    border-left: 2px solid var(--danger);
  }

  :global(.al-card-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-size: var(--step--2);
    color: var(--ink-faint);
    margin-bottom: var(--space-2xs);
  }

  :global(.al-tag) {
    background: var(--paper-sunk);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }

  :global(.al-tag-refused) {
    background: color-mix(in srgb, var(--danger) 12%, transparent);
    color: var(--danger);
  }

  :global(.al-question) {
    font-weight: 600;
    margin: 0 0 0.3rem;
  }

  :global(.al-answer) {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  :global(.al-clamped) {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.al-more) {
    margin-top: .3rem;
    min-height: 2.75rem;
    padding: 0 .2rem;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
  }

  :global(.al-sources) {
    margin: 0.3rem 0 0;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }
</style>
