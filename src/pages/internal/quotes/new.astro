---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import SupplierList from '../../../components/internal/SupplierList.astro';
import { pricing } from '../../../data/pricing';

// Everything the client script needs to compute a suggested price, in one
// serialised payload — same pattern CostEstimator.astro uses. This page
// suggests a starting price; every line stays editable, because a real quote
// reflects what Mark actually saw at the house, not a catalog lookup.
const catalog = {
  openings: pricing.openings.map((o) => ({ id: o.id, label: o.label, low: o.low, high: o.high, isDoor: !!o.isDoor, quotePrice: 'quotePrice' in o ? o.quotePrice : null })),
  materials: pricing.materials.map((m) => ({ id: m.id, label: m.label, multiplier: m.multiplier })),
  brands: pricing.brands.map((b) => ({ id: b.id, label: b.label, low: b.low, high: b.high })),
  // Siding is priced per square foot of total wall area (height times width), materials and labor included
  // (owner, 2026-10-22). No siding price is stored anywhere: these are only the kinds of work, and Mark types
  // the price per square foot on each quote.
  siding: [
    { id: 'siding-new', label: 'Siding, new construction' },
    { id: 'siding-existing', label: 'Siding, existing home' },
    { id: 'bb-new', label: 'Board and batten, new construction' },
    { id: 'bb-existing', label: 'Board and batten, existing home' },
    { id: 'cedar', label: 'Cedar siding' },
    { id: 'tearoff', label: 'Tear-off and new plywood' },
  ],
};
---
<InternalLayout title="New quote">
  <p class="kicker">Clearview internal</p>
  <h1 data-heading>New quote</h1>
  <p class="lede" data-lede>Build the scope, get a firm number, then sign or print.</p>
  <p class="qb-status" data-load-error hidden role="alert"></p>

  <form id="quote-form" data-catalog={JSON.stringify(catalog)}>
    <fieldset class="qb-block">
      <legend>Type of work</legend>
      <div class="qb-sig-choice" data-work-type-choice>
        <label class="choice"><input type="radio" name="workType" value="windows" checked /> Windows</label>
        <label class="choice"><input type="radio" name="workType" value="siding" /> Siding</label>
      </div>
      <p class="est-hint" data-work-type-hint>Window quotes go through the Build Plan before they can be signed. A siding quote is approved by its signature. The type is locked once the quote is saved.</p>
    </fieldset>

    <fieldset class="qb-block" data-notes-panel>
      <legend>Rough notes</legend>
      <p class="est-hint">Talk through the house or type it: room, window type, how many, anything extra. Lines appear in the quote below and you change the prices any time.</p>
      <label class="visually-hidden" for="rough-notes">Rough notes</label>
      <textarea id="rough-notes" data-rough-notes rows="5" maxlength="4000" enterkeyhint="enter" placeholder="Kitchen, two double-hungs, fin. Living room slider, vinyl Cascade. Back bedroom picture window, some rot at the sill..."></textarea>
      <p class="qb-sizes" data-sizes-heard hidden aria-live="polite"></p>
      <div class="qb-notes-actions">
        <button type="button" class="btn btn-primary qb-rec" data-rec-toggle aria-pressed="false"><span class="qb-rec-dot" aria-hidden="true"></span><span data-rec-label>Record</span></button>
        <button type="button" class="btn btn-ghost" data-draft-go>Draft lines</button>
        <button type="button" class="btn btn-ghost" data-draft-undo hidden>Undo draft</button>
        <button type="button" class="btn btn-ghost" data-retry-clips hidden>Retry recording</button>
        <button type="button" class="btn btn-ghost" data-discard-clips hidden>Delete saved recordings</button>
      </div>
      <div class="qb-mic" data-mic-row hidden>
        <label>Microphone
          <select data-mic-select></select>
        </label>
        <button type="button" class="btn btn-ghost" data-mic-allow>Allow microphone</button>
      </div>
      <p class="qb-note-status qb-note-problem" data-mic-help role="status" hidden></p>
      <div class="qb-level" data-level hidden aria-hidden="true"><span data-level-bar></span></div>
      <label class="choice qb-auto" data-speak-row hidden><input type="checkbox" data-speak-sizes /> Read the sizes back to me out loud (after I stop recording)</label>
      <label class="choice qb-auto"><input type="checkbox" data-auto-draft checked /> Draft the lines when I stop recording</label>
      <p class="qb-note-status" data-notes-status role="status" aria-live="polite" hidden></p>
      <p class="est-hint" data-rec-hint>Record your own notes, one room at a time. Washington needs everyone's OK to record a conversation, so ask the customer first or keep their voice out of it. Audio is never kept on our servers. If a recording cannot be sent (no signal), it waits on this phone until it can, then it is deleted. Keep the screen on while recording. No microphone? The keyboard microphone on your phone fills this box too.</p>
    </fieldset>

    <fieldset class="qb-block" data-measure-panel hidden>
      <legend>From Measurements</legend>
      <p class="est-hint" data-measure-summary></p>
      <ul class="qb-measure-list" data-measure-list></ul>
      <p class="qb-note-status qb-note-problem" data-measure-checks hidden></p>
      <div class="qb-notes-actions">
        <button type="button" class="btn btn-primary" data-measure-add>Add these to the quote</button>
        <button type="button" class="btn btn-ghost" data-measure-undo hidden>Undo</button>
      </div>
      <p class="qb-note-status" data-measure-status role="status" hidden></p>
    </fieldset>

    <fieldset class="qb-block">
      <legend>Customer</legend>
      <div class="qb-grid-2">
        <label>Name<input type="text" name="name" required maxlength="200" autocomplete="name" /></label>
        <label>Phone<input type="tel" inputmode="tel" name="phone" required maxlength="40" autocomplete="tel" /></label>
        <label>Email<input type="email" inputmode="email" name="email" maxlength="200" autocomplete="email" /></label>
        <label>City<input type="text" name="city" maxlength="120" /></label>
      </div>
      <label>Address<input type="text" name="address" maxlength="300" /></label>
      <fieldset class="qb-role">
        <legend class="visually-hidden">Who is this quote for</legend>
        <label class="choice"><input type="radio" name="role" value="Homeowner" checked /> Homeowner</label>
        <label class="choice"><input type="radio" name="role" value="Builder / GC" /> Builder / GC</label>
      </fieldset>
      <label>Notes (not printed on the contract)<textarea name="notes" rows="2" maxlength="4000"></textarea></label>
    </fieldset>

    <fieldset class="qb-block" data-wt-panel="siding" hidden>
      <legend>Add siding by the square foot</legend>
      <div class="qb-catalog-row">
        <label>Work
          <select data-siding-rate></select>
        </label>
        <label>Price per sq ft ($)
          <input type="number" inputmode="decimal" data-siding-price min="0.01" step="0.01" placeholder="your price" />
        </label>
        <label>Wall area (sq ft)
          <input type="number" inputmode="numeric" data-siding-area min="1" step="1" placeholder="height × width" />
        </label>
        <button type="button" class="btn btn-ghost" data-siding-add>Add line</button>
      </div>
      <p class="est-hint" data-siding-hint>Siding is priced by the square foot of total wall area (height times width), materials and labor included. Pick the kind of work, type your price per square foot and the wall area. Dry rot is added as a custom line once you have seen it. Every price stays editable.</p>
    </fieldset>

    <fieldset class="qb-block" data-wt-panel="windows">
      <legend>Add from the price book</legend>
      <div class="qb-catalog-row">
        <label>Opening
          <select data-catalog-opening></select>
        </label>
        <label>Material
          <select data-catalog-material></select>
        </label>
        <label>Brand
          <select data-catalog-brand></select>
        </label>
        <label>Method
          <select data-catalog-method>
            <option value="insert">Insert</option>
            <option value="fin">Fin</option>
          </select>
        </label>
        <label>Qty
          <input type="number" inputmode="numeric" data-catalog-qty value="1" min="1" step="1" />
        </label>
        <button type="button" class="btn btn-ghost" data-catalog-add>Add line</button>
      </div>
      <p class="est-hint">Adds one editable line with a suggested price — nothing here is final until you change it or leave it as-is.</p>
    </fieldset>

    <fieldset class="qb-block">
      <legend>Add a custom line</legend>
      <div class="qb-custom-row">
        <label>Label
          <input type="text" data-custom-label placeholder="e.g. Trim, rot repair, discount" maxlength="300" data-custom-placeholder-windows="e.g. Trim, rot repair, discount" data-custom-placeholder-siding="e.g. Siding material, dry rot, trim, discount" />
        </label>
        <label>Qty
          <input type="number" inputmode="numeric" data-custom-qty value="1" min="1" step="1" />
        </label>
        <label>Unit price ($)
          <input type="number" inputmode="decimal" data-custom-price value="0" step="0.01" min="0" />
        </label>
        <button type="button" class="btn btn-ghost" data-custom-add>Add line</button>
      </div>
    </fieldset>

    <fieldset class="qb-block">
      <legend>Line items</legend>
      <table class="qb-items">
        <thead>
          <tr><th>Line</th><th>Qty</th><th>Unit ($)</th><th>Total</th><th></th></tr>
        </thead>
        <tbody data-items-body></tbody>
      </table>
      <p class="est-empty" data-items-empty>Nothing added yet.</p>

      <p class="qb-unpriced" data-unpriced role="status" hidden></p>

      <div class="qb-totals">
        <label class="qb-discount">
          Discount ($)
          <input type="number" inputmode="decimal" data-discount value="0" min="0" step="0.01" />
        </label>
        <label class="qb-discount">
          Reason
          <input type="text" data-discount-reason maxlength="200" placeholder="optional" />
        </label>
        <div class="qb-total-line">
          <span>Subtotal</span><output data-subtotal>$0</output>
        </div>
        <div class="qb-total-line qb-total-line-final">
          <span>Total</span><output data-total>$0</output>
        </div>
      </div>
    </fieldset>

    <SupplierList />

    <fieldset class="qb-block">
      <legend>Signature</legend>
      <div class="qb-sig-choice">
        <label class="choice">
          <input type="radio" name="signatureMethod" value="digital" checked />
          Sign on screen now
        </label>
        <label class="choice">
          <input type="radio" name="signatureMethod" value="pen" />
          Print, sign by hand
        </label>
      </div>
    </fieldset>

    <p class="qb-status" data-status role="alert" hidden></p>
    <button class="btn btn-primary" type="submit" data-submit>Save &amp; continue</button>
    <!-- Phone only: the running total and the save button stay on screen while lines are edited. -->
    <div class="qb-dock" data-dock hidden><span class="qb-dock-total">Total <output data-dock-total>$0</output></span><button class="btn btn-primary" type="button" data-dock-save>Save &amp; continue</button></div>
  </form>
</InternalLayout>

<script>
  import { formatCents } from '../../../lib/money';
  import { bindSupplierList } from '../../../scripts/supplier-list';
  import { QUANTITY_MESSAGE, wholeQuantity } from '../../../lib/quote-lines';
  import { suggestedUnitPrice } from '../../../lib/quote-pricing';
  import { extractSizes, formatSize, spokenSize } from '../../../../functions/_lib/dimensions.mjs';
  import { createSilenceWatch, meterFill, rmsOfBytes } from '../../../lib/audio-level';
  import { deleteClip, discardAllClips, saveClip, waitingClips } from '../../../lib/clip-store';
  import { MEASUREMENT_KEY, MEASUREMENT_NOTES_HEADER, measurementNotes, readWorksheet, worksheetToLines } from '../../../lib/measurement-lines';
  import { NOTES_HEADER, draftLineToItem, mergeNotes, needsPrice, nextDraftText, notesBlock, type DraftCatalog, type DraftLine } from '../../../lib/quote-notes-lines';

  type CatalogOpening = { id: string; label: string; low: number; high: number; isDoor: boolean; quotePrice: number | null };
  type CatalogMaterial = { id: string; label: string; multiplier: number };
  type CatalogBrand = { id: string; label: string; low: number; high: number };
  type Catalog = {
    openings: CatalogOpening[];
    materials: CatalogMaterial[];
    brands: CatalogBrand[];
    siding: { id: string; label: string }[];
  };
  type WorkType = 'windows' | 'siding';
  type LineItem = { label: string; description: string; quantity: number; unitPrice: number };

  // Unsent rough notes survive a reload or a phone lock for 12 hours, on this device only.
  const NOTES_KEY = 'cv-quote-rough-notes';
  const AUTO_KEY = 'cv-quote-auto-draft';
  const store = {
    get(key: string) { try { return localStorage.getItem(key); } catch { return null; } },
    set(key: string, value: string) { try { localStorage.setItem(key, value); } catch { /* private window: notes just do not persist */ } },
    del(key: string) { try { localStorage.removeItem(key); } catch { /* nothing to remove */ } },
  };

  function initQuoteBuilder() {
    const form = document.getElementById('quote-form');
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const searchParams = new URLSearchParams(location.search);
    const editId = searchParams.get('edit');
    const duplicateId = editId ? null : searchParams.get('duplicate');
    const leadId = !editId && !duplicateId ? searchParams.get('leadId') : null;

    const catalog: Catalog = JSON.parse(form.dataset.catalog || '{}');
    const items: LineItem[] = [];

    // A problem with something typed into an add-line or line-item field, shown at the bottom of that block
    // (and the field focused) so it is visible on a phone, where the browser's own validation bubble may not be.
    function lineProblem(anchor: HTMLInputElement, message: string) {
      const host = anchor.closest('fieldset') ?? form;
      let el = host.querySelector(':scope > [data-line-problem]');
      if (!(el instanceof HTMLElement)) {
        if (!message) return;
        el = document.createElement('p');
        el.className = 'qb-status';
        el.setAttribute('role', 'alert');
        el.setAttribute('data-line-problem', '');
        host.append(el);
      }
      el.hidden = message === '';
      el.textContent = message;
      if (message) anchor.focus();
    }
    // Clear the message as soon as the field is edited again.
    function clearProblemOnEdit(input: HTMLInputElement) {
      input.addEventListener('input', () => lineProblem(input, ''));
    }

    // Windows or siding. Chosen here for a new quote (the ?type=siding link, a siding inquiry, or the radios)
    // and locked for an existing draft: the server refuses to change a saved quote's type.
    let workType: WorkType = searchParams.get('type') === 'siding' ? 'siding' : 'windows';
    const supplierList = bindSupplierList(form, () => ({
      lines: items, workType, reference: editId || '',
      valid: [...form.querySelectorAll<HTMLInputElement>('[data-line-qty]')].every(input => wholeQuantity(input.value) !== null),
    }));
    const sidingRateSelect = form.querySelector('[data-siding-rate]');
    const sidingAreaInput = form.querySelector('[data-siding-area]');
    const sidingPriceInput = form.querySelector('[data-siding-price]');
    const sidingHint = form.querySelector('[data-siding-hint]');
    const typeRadios = [...form.querySelectorAll('input[name="workType"]')].filter((el): el is HTMLInputElement => el instanceof HTMLInputElement);
    const moneyText = (dollars: number) => formatCents(Math.round(dollars * 100));

    const openingSelect = form.querySelector('[data-catalog-opening]');
    const materialSelect = form.querySelector('[data-catalog-material]');
    const brandSelect = form.querySelector('[data-catalog-brand]');
    const methodSelect = form.querySelector('[data-catalog-method]');
    const qtyInput = form.querySelector('[data-catalog-qty]');
    const itemsBody = form.querySelector('[data-items-body]');
    const itemsEmpty = form.querySelector('[data-items-empty]');
    const subtotalOut = form.querySelector('[data-subtotal]');
    const totalOut = form.querySelector('[data-total]');
    const dock = form.querySelector('[data-dock]');
    const dockOut = form.querySelector('[data-dock-total]');
    form.querySelector('[data-dock-save]')?.addEventListener('click', () => form.requestSubmit());
    const discountInput = form.querySelector('[data-discount]');

    if (
      !(openingSelect instanceof HTMLSelectElement) ||
      !(materialSelect instanceof HTMLSelectElement) ||
      !(brandSelect instanceof HTMLSelectElement) ||
      !(methodSelect instanceof HTMLSelectElement) ||
      !(qtyInput instanceof HTMLInputElement) ||
      !(itemsBody instanceof HTMLElement) ||
      !(itemsEmpty instanceof HTMLElement) ||
      !(subtotalOut instanceof HTMLElement) ||
      !(totalOut instanceof HTMLElement) ||
      !(discountInput instanceof HTMLInputElement)
    ) {
      return;
    }

    clearProblemOnEdit(qtyInput);
    if (sidingAreaInput instanceof HTMLInputElement) clearProblemOnEdit(sidingAreaInput);
    if (sidingPriceInput instanceof HTMLInputElement) clearProblemOnEdit(sidingPriceInput);

    for (const o of catalog.openings) {
      const opt = document.createElement('option');
      opt.value = o.id;
      opt.textContent = o.label;
      openingSelect.append(opt);
    }
    for (const m of catalog.materials) {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.label;
      materialSelect.append(opt);
    }
    for (const b of catalog.brands) {
      const opt = document.createElement('option');
      opt.value = b.id;
      opt.textContent = b.label;
      brandSelect.append(opt);
    }

    function currentOpening() {
      return catalog.openings.find((o) => o.id === openingSelect.value);
    }

    function syncBrandVisibility() {
      const opening = currentOpening();
      const isDoor = !!opening?.isDoor;
      brandSelect.disabled = isDoor;
      brandSelect.closest('label')?.classList.toggle('is-disabled', isDoor);
    }
    openingSelect.addEventListener('change', syncBrandVisibility);
    syncBrandVisibility();

    // Money is whole cents everywhere, exactly as the server computes it (quantity x the unit price
    // rounded to cents), and shown without rounding a cent away: $1,234.50 never reads "$1,235".
    const lineCents = (item: LineItem) => Math.round(item.quantity * Math.round(item.unitPrice * 100));
    let totalCells: HTMLElement[] = [];

    // Typing in a quantity or price must only refresh the numbers. Rebuilding the rows on every
    // keystroke replaced the field being typed in, so focus was lost after each digit.
    function updateTotals() {
      let subtotal = 0;
      items.forEach((item, index) => {
        const cents = lineCents(item);
        subtotal += cents;
        if (totalCells[index]) totalCells[index].textContent = formatCents(cents);
        totalCells[index]?.closest('tr')?.classList.toggle('qb-row-unpriced', needsPrice(item));
      });
      const discount = Math.max(0, Math.min(subtotal, Math.round((Number(discountInput.value) || 0) * 100)));
      const unpricedNote = form.querySelector('[data-unpriced]');
      if (unpricedNote instanceof HTMLElement) {
        const zero = items.filter(needsPrice).length;
        unpricedNote.hidden = zero === 0;
        unpricedNote.textContent = zero === 0 ? '' : `${zero} line${zero === 1 ? ' is' : 's are'} still at $0. Type a price on ${zero === 1 ? 'it' : 'each'} before this goes to the customer.`;
      }
      subtotalOut.textContent = formatCents(subtotal);
      totalOut.textContent = formatCents(subtotal - discount);
      if (dockOut) dockOut.textContent = formatCents(subtotal - discount);
      if (dock instanceof HTMLElement) dock.hidden = items.length === 0;
    }

    // Rebuilds the rows. Only for adding, removing and loading lines, never while typing.
    function render() {
      itemsBody.innerHTML = '';
      // The rows are rebuilt from the saved numbers, so a typed-but-rejected quantity is gone and so is its message.
      const staleProblem = itemsBody.closest('fieldset')?.querySelector(':scope > [data-line-problem]');
      if (staleProblem instanceof HTMLElement) staleProblem.hidden = true;
      totalCells = [];
      itemsEmpty.hidden = items.length > 0;

      items.forEach((item, index) => {
        const row = document.createElement('tr');

        const labelCell = document.createElement('td');
        labelCell.className = 'qb-cell-label';
        const labelInput = document.createElement('input');
        labelInput.type = 'text';
        labelInput.value = item.label;
        labelInput.maxLength = 300;
        labelInput.setAttribute('aria-label', 'Line description');
        labelInput.addEventListener('input', () => {
          items[index].label = labelInput.value;
        });
        labelCell.append(labelInput);

        const qtyCell = document.createElement('td');
        qtyCell.className = 'qb-cell-qty';
        qtyCell.dataset.cap = 'Qty';
        const qtyInputEl = document.createElement('input');
        qtyInputEl.type = 'number';
        qtyInputEl.inputMode = 'numeric';
        qtyInputEl.min = '1';
        qtyInputEl.step = '1';
        qtyInputEl.value = String(item.quantity);
        qtyInputEl.setAttribute('aria-label', 'Quantity');
        qtyInputEl.dataset.lineQty = '';
        qtyInputEl.addEventListener('input', () => {
          const whole = wholeQuantity(qtyInputEl.value);
          if (whole === null) {
            // Keep the last good quantity in the totals; the form will not save until this field is fixed.
            qtyInputEl.setAttribute('aria-invalid', 'true');
            lineProblem(qtyInputEl, QUANTITY_MESSAGE);
            return;
          }
          qtyInputEl.removeAttribute('aria-invalid');
          lineProblem(qtyInputEl, '');
          items[index].quantity = whole;
          updateTotals();
        });
        // The browser's own step/min check blocks the save before our submit handler runs; say why.
        qtyInputEl.addEventListener('invalid', () => {
          qtyInputEl.setAttribute('aria-invalid', 'true');
          lineProblem(qtyInputEl, QUANTITY_MESSAGE);
        });
        qtyCell.append(qtyInputEl);

        const priceCell = document.createElement('td');
        priceCell.className = 'qb-cell-price';
        priceCell.dataset.cap = 'Unit ($)';
        const priceInputEl = document.createElement('input');
        priceInputEl.type = 'number';
        priceInputEl.inputMode = 'decimal';
        priceInputEl.step = '0.01';
        priceInputEl.min = '0';
        priceInputEl.value = String(item.unitPrice);
        priceInputEl.setAttribute('aria-label', 'Unit price in dollars');
        priceInputEl.addEventListener('input', () => {
          items[index].unitPrice = Math.max(0, Number(priceInputEl.value) || 0);
          updateTotals();
        });
        priceCell.append(priceInputEl);

        const totalCell = document.createElement('td');
        totalCell.className = 'qb-line-total qb-cell-total';
        totalCell.dataset.cap = 'Total';
        totalCells.push(totalCell);

        const removeCell = document.createElement('td');
        removeCell.className = 'qb-cell-remove';
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'qb-remove';
        removeBtn.setAttribute('aria-label', `Remove ${item.label || 'line'}`);
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', () => {
          items.splice(index, 1);
          render();
        });
        removeCell.append(removeBtn);

        row.append(labelCell, qtyCell, priceCell, totalCell, removeCell);
        itemsBody.append(row);
      });

      updateTotals();
      supplierList.checkForChanges();
    }

    discountInput.addEventListener('input', updateTotals);

    const catalogAdd = form.querySelector('[data-catalog-add]');
    catalogAdd?.addEventListener('click', () => {
      const opening = currentOpening();
      if (!opening) return;
      const material = catalog.materials.find((m) => m.id === materialSelect.value) || catalog.materials[0];
      const brand = catalog.brands.find((b) => b.id === brandSelect.value);
      const method = methodSelect.value;
      const qty = wholeQuantity(qtyInput.value);
      if (qty === null) {
        lineProblem(qtyInput, QUANTITY_MESSAGE);
        return;
      }
      lineProblem(qtyInput, '');

      const isFin = method === 'fin';
      // Fin is only the method label on the line; it does not change the price.
      const unitPrice = suggestedUnitPrice({ opening, materialMultiplier: material?.multiplier, brand });

      const labelParts = [opening.label, material?.label, !opening.isDoor ? brand?.label : null, isFin ? 'fin' : 'insert'].filter(Boolean);

      items.push({ label: labelParts.join(' — '), description: '', quantity: qty, unitPrice });
      render();
    });


    // ── Rough notes: Mark's spoken or typed walk-through -> draft lines ─────────────────────────────────
    // Voice is optional. Clips are short (45 s) and sent on their own, so a dropped signal loses seconds, not the
    // house; a failed clip is kept for Retry. The words land in the box in the order they were spoken. Drafting
    // sends only the words added since the last draft, so room-by-room use never duplicates lines. The draft only
    // adds editable lines (price-book prices, or $0 for anything else), and nothing is saved until Mark saves.
    const roughNotes = form.querySelector('[data-rough-notes]');
    const recToggle = form.querySelector('[data-rec-toggle]');
    const recLabel = form.querySelector('[data-rec-label]');
    const draftGo = form.querySelector('[data-draft-go]');
    const draftUndo = form.querySelector('[data-draft-undo]');
    const retryClips = form.querySelector('[data-retry-clips]');
    const autoDraftBox = form.querySelector('[data-auto-draft]');
    const discardClips = form.querySelector('[data-discard-clips]');
    const levelEl = form.querySelector('[data-level]');
    const levelBar = form.querySelector('[data-level-bar]');
    const speakRow = form.querySelector('[data-speak-row]');
    const speakBox = form.querySelector('[data-speak-sizes]');
    const notesStatus = form.querySelector('[data-notes-status]');
    const sizesHeard = form.querySelector('[data-sizes-heard]');
    if (roughNotes instanceof HTMLTextAreaElement && recToggle instanceof HTMLButtonElement && recLabel instanceof HTMLElement && draftGo instanceof HTMLButtonElement && draftUndo instanceof HTMLButtonElement && retryClips instanceof HTMLButtonElement && autoDraftBox instanceof HTMLInputElement && discardClips instanceof HTMLButtonElement && speakRow instanceof HTMLElement && speakBox instanceof HTMLInputElement && notesStatus instanceof HTMLElement) {
      const buzz = (ms: number) => { try { navigator.vibrate?.(ms); } catch { /* not every phone vibrates */ } };
      const say = (message: string, problem = false) => {
        notesStatus.hidden = message === '';
        notesStatus.textContent = message;
        notesStatus.classList.toggle('qb-note-problem', problem);
      };
      // Errors say whether trying again can help: no signal, a busy server and an expired sign-in can; a clip that is too long cannot.
      class AskError extends Error { retryable: boolean; constructor(message: string, retryable: boolean) { super(message); this.retryable = retryable; } }
      const askJson = async (url: string, init: RequestInit) => {
        let response: Response;
        try { response = await fetch(url, { credentials: 'same-origin', ...init }); } catch { throw new AskError('No signal right now.', true); }
        // An expired sign-in redirects to the login page, which is HTML, not JSON.
        if (!(response.headers.get('content-type') || '').includes('json')) throw new AskError('Your sign-in expired. Sign in again; your notes are still here.', true);
        const data = await response.json();
        if (!response.ok) throw new AskError(typeof data?.error === 'string' ? data.error : 'That did not work. Your notes are still here.', response.status >= 500 || response.status === 429 || response.status === 401);
        return data;
      };

      let consumed = '';                 // the part of the notes already drafted
      let previousConsumed = '';         // restored by Undo
      let lastBatch: LineItem[] = [];    // lines from the last draft (Undo)
      let allDrafted: LineItem[] = [];   // every drafted line still on the quote (replace-all)
      let drafting = false;
      let draftAgain = false;
      let pendingClips = 0;
      let draftAfterStop = false;
      let chain: Promise<void> = Promise.resolve();
      let failedClips: { blob: Blob; id: number | null }[] = [];

      // Keep unsent notes across a reload (the lines themselves are rebuilt from them).
      // Every size in the box, read by code in the standard form (width x height, inches, fractions with a slash), so
      // Mark can check what was heard against the tape without waiting for a draft.
      const showSizes = () => {
        if (!(sizesHeard instanceof HTMLElement)) return;
        const sizes = extractSizes(roughNotes.value);
        sizesHeard.hidden = sizes.length === 0;
        sizesHeard.replaceChildren();
        if (sizes.length === 0) return;
        sizesHeard.append(document.createTextNode('Sizes heard (width x height, inches): '));
        sizes.forEach((size, index) => {
          const chip = document.createElement('strong');
          chip.textContent = `${formatSize(size)}${size.rounded ? ' (rounded to 1/16, check)' : ''}`;
          sizesHeard.append(chip);
          if (index < sizes.length - 1) sizesHeard.append(document.createTextNode('   '));
        });
      };
      roughNotes.addEventListener('input', showSizes);
      const saveNotes = () => { if (editId) return; if (roughNotes.value.trim()) store.set(NOTES_KEY, JSON.stringify({ text: roughNotes.value, at: Date.now() })); else store.del(NOTES_KEY); };
      roughNotes.addEventListener('input', saveNotes);
      autoDraftBox.checked = store.get(AUTO_KEY) !== '0';
      autoDraftBox.addEventListener('change', () => store.set(AUTO_KEY, autoDraftBox.checked ? '1' : '0'));
      if ('speechSynthesis' in window) {
        speakRow.hidden = false;
        speakBox.checked = store.get('cv-quote-speak') === '1';
        speakBox.addEventListener('change', () => store.set('cv-quote-speak', speakBox.checked ? '1' : '0'));
      }
      if (!editId) {
        try {
          const saved = JSON.parse(store.get(NOTES_KEY) || 'null');
          if (saved && typeof saved.text === 'string' && saved.text.trim() && Date.now() - Number(saved.at) < 12 * 3600_000 && roughNotes.value.trim() === '') {
            roughNotes.value = saved.text.slice(0, 4000);
            showSizes();
            say('Restored your unsent notes. Tap Draft lines to rebuild the quote lines.');
          }
        } catch { /* unreadable saved notes: start empty */ }
      }

      const setBusy = () => { draftGo.disabled = drafting; };
      const showRetry = () => {
        retryClips.hidden = failedClips.length === 0;
        discardClips.hidden = failedClips.length === 0;
        retryClips.textContent = failedClips.length > 1 ? `Retry ${failedClips.length} recordings` : 'Retry recording';
      };

      async function runDraft(auto: boolean) {
        if (drafting) { draftAgain = true; return; }
        const { text, replaceAll } = nextDraftText(roughNotes.value, consumed);
        if (!text) { say(auto ? '' : roughNotes.value.trim() ? 'Nothing new to draft since the last time. Add more notes first.' : 'Type or record some notes first.', !auto); if (!auto && !roughNotes.value.trim()) roughNotes.focus(); return; }
        if (pendingClips > 0) { say('Still writing out the last recording. Try again in a moment.', true); return; }
        if (replaceAll && allDrafted.length > 0 && !window.confirm('You changed notes that were already drafted. Redraft everything and replace the lines drafted before? (Prices you typed on those lines will be lost.)')) return;
        const wholeBox = roughNotes.value.trim();
        drafting = true; setBusy();
        say('Drafting lines...');
        try {
          const data = await askJson('/internal/api/quote-notes', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ notes: text }) });
          const lines: DraftLine[] = Array.isArray(data.lines) ? data.lines : [];
          if (replaceAll) { for (const old of allDrafted) { const at = items.indexOf(old); if (at >= 0) items.splice(at, 1); } allDrafted = []; }
          const added: LineItem[] = [];
          for (const line of lines) {
            const item = draftLineToItem(line, catalog as DraftCatalog, workType);
            if (item) { items.push(item); added.push(item); }
          }
          lastBatch = added;
          allDrafted = allDrafted.concat(added);
          previousConsumed = replaceAll ? '' : consumed;
          consumed = wholeBox;
          const c = data.customer && typeof data.customer === 'object' ? data.customer : {};
          for (const [field, value] of [['name', c.name], ['phone', c.phone], ['address', c.address], ['city', c.city]] as const) {
            const el = form.elements.namedItem(field);
            if (typeof value === 'string' && value && el instanceof HTMLInputElement && el.value.trim() === '') el.value = value;
          }
          const notesField = form.elements.namedItem('notes');
          if (notesField instanceof HTMLTextAreaElement) {
            let existing = notesField.value;
            if (replaceAll && existing.includes(NOTES_HEADER)) existing = existing.slice(0, existing.indexOf(NOTES_HEADER)).trimEnd();
            notesField.value = mergeNotes(existing, notesBlock(text, lines, !existing.includes(NOTES_HEADER)));
          }
          render();
          draftUndo.hidden = added.length === 0;
          const unpriced = added.filter(needsPrice).length;
          const skipped = Number(data.dropped) || 0;
          say(added.length === 0
            ? 'No quotable lines found in those notes. They were kept in the quote notes; add lines by hand.'
            : `Added ${added.length} line${added.length === 1 ? '' : 's'}.${unpriced ? ` ${unpriced} still need${unpriced === 1 ? 's' : ''} a price (shown at $0).` : ''} Check every price and quantity before you save.${skipped ? ` ${skipped} part${skipped === 1 ? '' : 's'} of the notes could not be matched; check them.` : ''}`, added.length === 0 || skipped > 0);
          buzz(added.length ? 30 : 0);
        } catch (error) {
          say(error instanceof Error ? error.message : 'Could not draft lines. Your notes are still here.', true);
        } finally {
          drafting = false; setBusy();
          if (draftAgain) { draftAgain = false; void runDraft(true); }
        }
      }
      draftGo.addEventListener('click', () => { void runDraft(false); });
      draftUndo.addEventListener('click', () => {
        for (const item of lastBatch) {
          const at = items.indexOf(item);
          if (at >= 0) items.splice(at, 1);
        }
        allDrafted = allDrafted.filter((item) => !lastBatch.includes(item));
        lastBatch = [];
        consumed = previousConsumed;
        draftUndo.hidden = true;
        render();
        say('Draft removed. Tap Draft lines to try again; your notes are still in the box.');
      });

      // Recording. Hidden where the browser has no recorder; the keyboard microphone still works there.
      const canRecord = typeof MediaRecorder !== 'undefined' && !!navigator.mediaDevices?.getUserMedia;
      if (!canRecord) {
        recToggle.hidden = true;
        autoDraftBox.closest('label')?.setAttribute('hidden', '');
      } else {
        // ── Microphone: permission, choice of input, and what to do when the browser says no ─────────────
        // A page cannot reopen a permission the browser has blocked, so the control does what it can: ask again
        // (works while the browser is still asking), list and remember the inputs, react when one is plugged in or
        // removed, and when the block is real, say exactly where to undo it on this phone and re-check on a tap.
        const MIC_KEY = 'cv-quote-mic';
        const micRow = form.querySelector('[data-mic-row]');
        const micSelect = form.querySelector('[data-mic-select]');
        const micAllow = form.querySelector('[data-mic-allow]');
        const micHelp = form.querySelector('[data-mic-help]');
        let permission: PermissionState | 'unknown' = 'unknown';
        const micName = (error: unknown) => (error instanceof DOMException || error instanceof Error ? error.name : '');
        const blockedSteps = () => {
          const ua = navigator.userAgent;
          if (/iPhone|iPad|iPod/.test(ua)) return 'On iPhone: tap the "aA" button in the address bar, choose Website Settings, set Microphone to Allow, then tap Check again.';
          if (/Android/.test(ua)) return 'On Android: tap the lock icon next to the address, choose Permissions, set Microphone to Allow, then tap Check again.';
          return 'Click the lock icon next to the address, set Microphone to Allow, then click Check again.';
        };
        const micProblem = (error: unknown) => {
          const name = micName(error);
          if (name === 'NotFoundError') return 'No microphone was found on this device. Type your notes, or plug one in.';
          if (name === 'NotReadableError' || name === 'AbortError') return 'Another app is using the microphone. Close it, then tap Record again.';
          if (name === 'NotAllowedError' || name === 'SecurityError') return 'The microphone is blocked for this site.';
          return 'Could not start the microphone. Type your notes, or try again.';
        };
        const renderMic = () => {
          if (!(micRow instanceof HTMLElement) || !(micSelect instanceof HTMLSelectElement) || !(micAllow instanceof HTMLButtonElement) || !(micHelp instanceof HTMLElement)) return;
          const granted = permission === 'granted';
          micRow.hidden = false;
          micSelect.hidden = !granted || micSelect.options.length < 2;
          micSelect.closest('label')?.toggleAttribute('hidden', micSelect.hidden);
          micAllow.hidden = granted;
          micAllow.textContent = permission === 'denied' ? 'Check again' : 'Allow microphone';
          micHelp.hidden = permission !== 'denied';
          micHelp.textContent = permission === 'denied' ? `The browser has blocked the microphone for this site, and a web page cannot undo that. ${blockedSteps()}` : '';
        };
        const refreshMics = async () => {
          if (!(micSelect instanceof HTMLSelectElement)) return;
          try {
            const mics = (await navigator.mediaDevices.enumerateDevices()).filter((d) => d.kind === 'audioinput' && d.deviceId);
            const saved = store.get(MIC_KEY) || '';
            micSelect.replaceChildren(new Option("Phone's default microphone", ''));
            mics.forEach((d, i) => micSelect.append(new Option(d.label || `Microphone ${i + 1}`, d.deviceId)));
            micSelect.value = mics.some((d) => d.deviceId === saved) ? saved : '';
            if (saved && micSelect.value === '') store.del(MIC_KEY);
          } catch { /* no device list: the default microphone still works */ }
          renderMic();
        };
        const readPermission = async () => {
          try {
            const state = await navigator.permissions.query({ name: 'microphone' as PermissionName });
            permission = state.state;
            state.onchange = () => { permission = state.state; void refreshMics(); };
          } catch { /* this browser cannot say; the Allow button still works */ }
          await refreshMics();
        };
        micSelect?.addEventListener('change', () => { if (micSelect instanceof HTMLSelectElement) { if (micSelect.value) store.set(MIC_KEY, micSelect.value); else store.del(MIC_KEY); } });
        navigator.mediaDevices.addEventListener?.('devicechange', () => { void refreshMics(); });
        micAllow?.addEventListener('click', async () => {
          try {
            const probe = await navigator.mediaDevices.getUserMedia({ audio: true });
            probe.getTracks().forEach((track) => track.stop());
            permission = 'granted';
            say('Microphone is on. Tap Record when you are ready.');
          } catch (error) {
            if (micName(error) === 'NotAllowedError' || micName(error) === 'SecurityError') permission = 'denied';
            say(micProblem(error), true);
          }
          await readPermission();
        });
        // The chosen input if it is still there, otherwise the default one (an unplugged headset must not stop a recording).
        const openMic = async () => {
          const saved = store.get(MIC_KEY);
          try {
            return await navigator.mediaDevices.getUserMedia({ audio: saved ? { deviceId: { exact: saved } } : true });
          } catch (error) {
            if (saved && (micName(error) === 'OverconstrainedError' || micName(error) === 'NotFoundError')) {
              store.del(MIC_KEY);
              say('That microphone is not available, so I am using the default one.');
              return navigator.mediaDevices.getUserMedia({ audio: true });
            }
            throw error;
          }
        };
        void readPermission();

        const CLIP_MS = 45_000;
        let stream: MediaStream | null = null;
        let recorder: MediaRecorder | null = null;
        let cutTimer: number | undefined;
        let tick: number | undefined;
        let startedAt = 0;
        let recording = false;
        let wakeLock: WakeLockSentinel | null = null;
        const pickType = () => ['audio/webm;codecs=opus', 'audio/mp4', 'audio/webm', 'audio/ogg'].find((t) => MediaRecorder.isTypeSupported(t)) || '';
        const clock = () => { const n = Math.floor((Date.now() - startedAt) / 1000); return `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`; };

        // Clips are transcribed in parallel but added to the notes strictly in the order they were recorded.
        const speakSizes = (sizes: string[]) => {
          if (!speakBox.checked || recording || !('speechSynthesis' in window)) return;
          const phrases = sizes.map((size) => extractSizes(size)[0]).filter(Boolean).map((size) => spokenSize(size));
          if (!phrases.length) return;
          try {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(phrases.join('. Then '));
            utterance.rate = 0.95; utterance.lang = 'en-US';
            window.speechSynthesis.speak(utterance);
          } catch { /* no voice on this phone: the sizes are still on screen */ }
        };

        // Clips are transcribed in parallel but added to the notes strictly in the order they were recorded. A clip is
        // saved on this phone before it is sent and deleted once it is written out, so a dropped signal, a reload or a
        // locked phone cannot lose what Mark said at a window.
        const sendClip = (blob: Blob, existingId: number | null = null) => {
          // A clip with almost no audio (stopped at once, or the microphone gave nothing) is not sent, but it still
          // finishes the stop sequence below, so the screen never stays on "Writing out what you said...".
          const silent = blob.size < 2000;
          pendingClips += 1;
          const stored: Promise<number | null> = silent ? Promise.resolve(null) : existingId !== null ? Promise.resolve(existingId) : saveClip(blob);
          const failed = (error: unknown) => ({ data: null, error: error instanceof Error ? error : new AskError('Could not write out that clip.', true) });
          const result: Promise<{ data: any; error: Error | null }> = silent
            ? Promise.resolve({ data: { empty: true, text: '' }, error: null })
            : navigator.onLine === false
              ? Promise.resolve(failed(new AskError('No signal right now.', true)))
              : askJson('/internal/api/quote-dictation', { method: 'POST', headers: { 'content-type': blob.type || 'audio/webm' }, body: blob }).then((data) => ({ data, error: null as Error | null }), failed);
          chain = chain.then(async () => {
            const { data, error } = await result;
            const id = await stored;
            pendingClips -= 1;
            const bad = Boolean(error) || !data;
            if (!bad && id !== null) void deleteClip(id);
            if (bad) {
              if ((error as AskError | null)?.retryable === false) {
                // Sending it again cannot help (for example it was too long): do not keep it.
                if (id !== null) void deleteClip(id);
                say(`${error?.message || 'That recording could not be used.'} Record that part again, or type it.`, true);
              } else {
                failedClips.push({ blob, id });
                showRetry();
                say(`${error?.message || 'Could not write out that clip.'} Your recording is kept on this phone and will send when you are back online. You can also tap Retry, or type it.`, true);
              }
            }
            else if (data.empty || !data.text) { draftAfterStop = false; say('I did not hear any words. Hold the phone closer and try again.', true); }
            else {
              roughNotes.value = `${roughNotes.value.trimEnd()}${roughNotes.value.trim() ? '\n' : ''}${data.text}`.slice(0, 4000);
              saveNotes();
              showSizes();
              // Read the sizes back right away, in the standard form, so a mishearing is caught while Mark is still at the window.
              const sizes: string[] = Array.isArray(data.sizes) ? data.sizes : [];
              const heardSizes = sizes.length ? ` Sizes heard (width x height): ${sizes.join('  |  ')}.${Number(data.roundedSizes) > 0 ? ' One was rounded to the nearest 1/16, so say it again if it is not right.' : ''}` : '';
              say(`${recording ? 'Recording...' : 'Added to the notes.'}${heardSizes}`, Number(data.roundedSizes) > 0);
              speakSizes(sizes);
            }
            if (!recording && pendingClips === 0) {
              if (draftAfterStop && failedClips.length === 0) { draftAfterStop = false; await runDraft(true); }
              else if (failedClips.length === 0) say(notesStatus.classList.contains('qb-note-problem') ? notesStatus.textContent || '' : 'Added to the notes. Tap Draft lines when you are ready.');
            }
          });
        };
        const retryAll = () => {
          if (!failedClips.length) return;
          const again = failedClips; failedClips = []; showRetry();
          say('Writing out what you said...');
          again.forEach(({ blob, id }) => sendClip(blob, id));
        };
        retryClips.addEventListener('click', retryAll);
        // Signal is back (out of the basement): send what was waiting, unless Mark is mid-recording.
        window.addEventListener('online', () => { if (!recording && failedClips.length) { say('Back online. Sending your saved recordings.'); retryAll(); } });
        discardClips.addEventListener('click', async () => {
          if (!window.confirm('Delete the saved recordings from this phone? What they said will be lost.')) return;
          await discardAllClips();
          failedClips = []; showRetry();
          say('Saved recordings deleted.');
        });
        // Recordings left from earlier (the page was reloaded or closed before they could be sent) are offered, never sent on their own:
        // they may belong to a different quote.
        void waitingClips().then((rows) => {
          if (!rows.length || recording || failedClips.length) return;
          failedClips = rows.map((row) => ({ blob: row.blob, id: row.id }));
          showRetry();
          const minutes = Math.max(1, Math.round((Date.now() - rows[0].at) / 60000));
          say(`${rows.length} recording${rows.length === 1 ? ' was' : 's were'} saved on this phone from ${minutes < 60 ? `${minutes} minute${minutes === 1 ? '' : 's'}` : `${Math.round(minutes / 60)} hour${Math.round(minutes / 60) === 1 ? '' : 's'}`} ago and ${rows.length === 1 ? 'has' : 'have'} not been written out. Tap Retry to add ${rows.length === 1 ? 'it' : 'them'} to these notes, or delete ${rows.length === 1 ? 'it' : 'them'} if ${rows.length === 1 ? 'it belongs' : 'they belong'} to another quote.`, true);
        });

        // A live level meter, so Mark can see the microphone is hearing him, and a warning if it is not (covered, wrong input).
        let audioCtx: AudioContext | null = null;
        let meterFrame = 0;
        const startMeter = (source: MediaStream) => {
          try {
            const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
            if (!Ctx || !(levelEl instanceof HTMLElement) || !(levelBar instanceof HTMLElement)) return;
            audioCtx = new Ctx();
            void audioCtx.resume().catch(() => {});
            const analyser = audioCtx.createAnalyser();
            analyser.fftSize = 1024;
            audioCtx.createMediaStreamSource(source).connect(analyser);
            const samples = new Uint8Array(analyser.fftSize);
            const watch = createSilenceWatch();
            levelEl.hidden = false;
            const loop = () => {
              analyser.getByteTimeDomainData(samples);
              const level = rmsOfBytes(samples);
              levelBar.style.transform = `scaleX(${meterFill(level)})`;
              const change = watch.feed(level, Date.now());
              if (change === 'silent') say("I am not hearing anything. Is something covering the microphone, or is it the wrong one?", true);
              else if (change === 'recovered') say('Recording. Keep the screen on and tap Stop when you finish the room.');
              meterFrame = requestAnimationFrame(loop);
            };
            meterFrame = requestAnimationFrame(loop);
          } catch { audioCtx = null; /* no meter on this browser; recording still works */ }
        };
        const stopMeter = () => {
          cancelAnimationFrame(meterFrame);
          if (levelEl instanceof HTMLElement) levelEl.hidden = true;
          void audioCtx?.close().catch(() => {});
          audioCtx = null;
        };

        const startSegment = () => {
          if (!stream || !recording) return;
          const mime = pickType();
          const rec = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
          const parts: Blob[] = [];
          rec.ondataavailable = (event) => { if (event.data.size) parts.push(event.data); };
          rec.onstop = () => { sendClip(new Blob(parts, { type: rec.mimeType || mime || 'audio/webm' })); };
          rec.start();
          recorder = rec;
          cutTimer = window.setTimeout(() => { if (recording) { rec.stop(); startSegment(); } }, CLIP_MS);
        };

        const stopRecording = () => {
          recording = false;
          window.clearTimeout(cutTimer);
          window.clearInterval(tick);
          if (recorder && recorder.state !== 'inactive') recorder.stop();
          stream?.getTracks().forEach((track) => track.stop());
          stream = null;
          void wakeLock?.release().catch(() => {});
          wakeLock = null;
          stopMeter();
          if (micSelect instanceof HTMLSelectElement) micSelect.disabled = false;
          recToggle.classList.remove('qb-rec-live');
          recLabel.textContent = 'Record';
          recToggle.setAttribute('aria-pressed', 'false');
        };

        recToggle.addEventListener('click', async () => {
          if (recording) {
            draftAfterStop = autoDraftBox.checked;
            stopRecording();
            buzz(20);
            say('Writing out what you said...');
            return;
          }
          try {
            stream = await openMic();
          } catch (error) {
            if (micName(error) === 'NotAllowedError' || micName(error) === 'SecurityError') permission = 'denied';
            say(`${micProblem(error)} You can also use the keyboard microphone on your phone.`, true);
            await readPermission();
            return;
          }
          permission = 'granted';
          void refreshMics();
          if (micSelect instanceof HTMLSelectElement) micSelect.disabled = true;
          recording = true;
          startedAt = Date.now();
          recToggle.classList.add('qb-rec-live');
          recToggle.setAttribute('aria-pressed', 'true');
          recLabel.textContent = `Stop  ${clock()}`;
          tick = window.setInterval(() => { recLabel.textContent = `Stop  ${clock()}`; }, 500);
          buzz(20);
          say('Recording. Keep the screen on and tap Stop when you finish the room.');
          if (stream) startMeter(stream);
          try { wakeLock = (await navigator.wakeLock?.request('screen')) ?? null; } catch { /* the screen may sleep; the hint says to keep it on */ }
          startSegment();
        });
        // Leaving the page or locking the phone ends the recording: send what was captured instead of losing it.
        window.addEventListener('pagehide', () => { if (recording) stopRecording(); });
        document.addEventListener('visibilitychange', () => { if (document.hidden && recording) { draftAfterStop = false; stopRecording(); say('Recording stopped because the screen turned off. What you said so far is being written out; tap Record to continue.', true); } });
      }
    }

    // ── From Measurements: the worksheet Mark filled in with a tape -> editable quote lines ─────────────────
    // Shows exactly what will be added (so he can read it back against the worksheet), adds the lines with the same
    // price-book starting prices as every other draft (types the price book does not have come in at $0, flagged), keeps
    // sizes in the standard form, and can be undone exactly. Existing lines are never touched.
    const measurePanel = form.querySelector('[data-measure-panel]');
    const measureSummary = form.querySelector('[data-measure-summary]');
    const measureList = form.querySelector('[data-measure-list]');
    const measureChecks = form.querySelector('[data-measure-checks]');
    const measureAdd = form.querySelector('[data-measure-add]');
    const measureUndo = form.querySelector('[data-measure-undo]');
    const measureStatus = form.querySelector('[data-measure-status]');
    if (measurePanel instanceof HTMLElement && measureSummary instanceof HTMLElement && measureList instanceof HTMLElement && measureChecks instanceof HTMLElement && measureAdd instanceof HTMLButtonElement && measureUndo instanceof HTMLButtonElement && measureStatus instanceof HTMLElement) {
      const sheet = readWorksheet(store.get(MEASUREMENT_KEY));
      if (sheet) {
        const plan = worksheetToLines(sheet);
        const units = sheet.openings.reduce((n, o) => n + o.quantity, 0);
        measurePanel.hidden = false;
        measureSummary.textContent = `${sheet.openings.length} opening${sheet.openings.length === 1 ? '' : 's'} (${units} unit${units === 1 ? '' : 's'}) in your Measurements worksheet${sheet.jobName ? ` for ${sheet.jobName}` : ''}. Check them, then add them to this quote.`;
        for (const o of sheet.openings) {
          const li = document.createElement('li');
          const size = plan.lines[sheet.openings.indexOf(o)];
          li.textContent = `${o.room || 'Opening'} · ${o.type} · ${size && 'size' in size && size.size ? size.size : o.type === 'Other' || size?.type === 'custom' ? 'see line' : 'no size'}${o.quantity > 1 ? ` · x${o.quantity}` : ''}`;
          measureList.append(li);
        }
        if (plan.checks.length) { measureChecks.hidden = false; measureChecks.textContent = plan.checks.join(' '); }
        let importedItems: LineItem[] = [];
        const measureSay = (message: string) => { measureStatus.hidden = message === ''; measureStatus.textContent = message; };
        measureAdd.addEventListener('click', () => {
          if (importedItems.length) return;
          const added: LineItem[] = [];
          for (const line of plan.lines) {
            const item = draftLineToItem(line, catalog as DraftCatalog, workType);
            if (item) { items.push(item); added.push(item); }
          }
          importedItems = added;
          for (const [field, value] of [['address', sheet.jobAddress]] as const) {
            const el = form.elements.namedItem(field);
            if (value && el instanceof HTMLInputElement && el.value.trim() === '') el.value = value;
          }
          const block = measurementNotes(sheet);
          const notesField = form.elements.namedItem('notes');
          if (block && notesField instanceof HTMLTextAreaElement) notesField.value = mergeNotes(notesField.value, block);
          render();
          measureAdd.disabled = true;
          measureUndo.hidden = false;
          const zero = added.filter(needsPrice).length;
          measureSay(`Added ${added.length} line${added.length === 1 ? '' : 's'} from Measurements.${zero ? ` ${zero} still need${zero === 1 ? 's' : ''} a price (shown at $0).` : ''} Check every price and quantity before you save.`);
        });
        measureUndo.addEventListener('click', () => {
          for (const item of importedItems) { const at = items.indexOf(item); if (at >= 0) items.splice(at, 1); }
          importedItems = [];
          measureAdd.disabled = false;
          measureUndo.hidden = true;
          render();
          measureSay('Removed. Your worksheet is untouched.');
        });
      }
    }

    const customLabel = form.querySelector('[data-custom-label]');
    const customQty = form.querySelector('[data-custom-qty]');
    const customPrice = form.querySelector('[data-custom-price]');
    const customAdd = form.querySelector('[data-custom-add]');
    if (customQty instanceof HTMLInputElement) clearProblemOnEdit(customQty);
    customAdd?.addEventListener('click', () => {
      if (!(customLabel instanceof HTMLInputElement) || !(customQty instanceof HTMLInputElement) || !(customPrice instanceof HTMLInputElement)) return;
      const label = customLabel.value.trim();
      if (!label) {
        customLabel.focus();
        return;
      }
      const customQuantity = wholeQuantity(customQty.value);
      if (customQuantity === null) {
        lineProblem(customQty, QUANTITY_MESSAGE);
        return;
      }
      lineProblem(customQty, '');
      items.push({
        label,
        description: '',
        quantity: customQuantity,
        unitPrice: Number(customPrice.value) || 0,
      });
      customLabel.value = '';
      customQty.value = '1';
      customPrice.value = '0';
      render();
    });

    if (sidingRateSelect instanceof HTMLSelectElement) {
      for (const rate of catalog.siding || []) {
        const opt = document.createElement('option');
        opt.value = rate.id;
        opt.textContent = rate.label;
        sidingRateSelect.append(opt);
      }
    }
    form.querySelector('[data-siding-add]')?.addEventListener('click', () => {
      if (!(sidingRateSelect instanceof HTMLSelectElement) || !(sidingAreaInput instanceof HTMLInputElement) || !(sidingPriceInput instanceof HTMLInputElement)) return;
      const rate = (catalog.siding || []).find((entry) => entry.id === sidingRateSelect.value);
      const area = Math.round(Number(sidingAreaInput.value));
      if (!rate) return;
      if (!Number.isFinite(area) || area < 1) {
        lineProblem(sidingAreaInput, 'Enter the wall area in square feet, 1 or more.');
        return;
      }
      lineProblem(sidingAreaInput, '');
      const price = Number(sidingPriceInput.value);
      if (!Number.isFinite(price) || price <= 0) {
        lineProblem(sidingPriceInput, 'Enter your price per square foot, more than $0.');
        return;
      }
      lineProblem(sidingPriceInput, '');
      // Quantity is square feet of wall; the unit price is the per-square-foot price Mark typed (materials and labor included).
      // The price stays as typed for the next line: most of a quote's siding runs at one rate.
      items.push({ label: rate.label, description: 'Per sq ft of total wall area (height × width), materials and labor included', quantity: area, unitPrice: Math.round(price * 100) / 100 });
      sidingAreaInput.value = '';
      render();
    });

    function applyWorkType() {
      form.querySelectorAll('[data-wt-panel]').forEach((panel) => {
        if (panel instanceof HTMLElement) panel.hidden = panel.dataset.wtPanel !== workType;
      });
      typeRadios.forEach((radio) => { radio.checked = radio.value === workType; });
      const customLabelInput = form.querySelector('[data-custom-label]');
      if (customLabelInput instanceof HTMLInputElement) {
        customLabelInput.placeholder = (workType === 'siding' ? customLabelInput.dataset.customPlaceholderSiding : customLabelInput.dataset.customPlaceholderWindows) || customLabelInput.placeholder;
      }
      if (!editId && !duplicateId && !leadId) {
        const heading = document.querySelector('[data-heading]');
        if (heading) heading.textContent = workType === 'siding' ? 'New siding quote' : 'New quote';
      }
    }
    typeRadios.forEach((radio) => radio.addEventListener('change', () => {
      if (!radio.checked || (radio.value !== 'windows' && radio.value !== 'siding')) return;
      workType = radio.value;
      applyWorkType();
    }));
    applyWorkType();

    render();

    const status = form.querySelector('[data-status]');
    const submitBtn = form.querySelector('[data-submit]');
    const headingEl = document.querySelector('[data-heading]');
    const ledeEl = document.querySelector('[data-lede]');
    const loadErrorEl = document.querySelector('[data-load-error]');

    function setField(name: string, value: string) {
      const el = form.elements.namedItem(name);
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) el.value = value ?? '';
    }
    function setRadio(name: string, value: string) {
      const el = form.querySelector(`input[name="${name}"][value="${value}"]`);
      if (el instanceof HTMLInputElement) el.checked = true;
    }

    async function loadForEdit(id: string, mode: 'edit' | 'duplicate') {
      form.querySelectorAll('input, select, textarea, button').forEach((el) => {
        if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement || el instanceof HTMLButtonElement) {
          el.disabled = true;
        }
      });

      try {
        const response = await fetch(`/internal/api/quotes/${encodeURIComponent(id)}`);
        if (!response.ok) throw new Error('Could not load that quote.');
        const { quote, items: loadedItems } = await response.json();
        if (mode === 'edit' && quote.status !== 'draft') {
          throw new Error('This quote is already finalized and can no longer be edited.');
        }

        if (mode === 'edit') {
          if (headingEl) headingEl.textContent = `Edit quote ${quote.id}`;
          if (ledeEl) ledeEl.textContent = 'Fix anything below, then save — nothing is signed yet.';
          if (submitBtn instanceof HTMLButtonElement) submitBtn.textContent = 'Save changes';
        } else {
          if (headingEl) headingEl.textContent = 'New quote (copied)';
          if (ledeEl) ledeEl.textContent = `Copied from ${quote.id} — check the customer details before you save.`;
        }

        workType = quote.work_type === 'siding' ? 'siding' : 'windows';
        applyWorkType();
        setField('name', quote.customer_name);
        setField('phone', quote.customer_phone);
        setField('email', quote.customer_email);
        setField('address', quote.customer_address);
        setField('city', quote.customer_city);
        setField('notes', quote.notes);
        if (quote.customer_role) setRadio('role', quote.customer_role);
        setRadio('signatureMethod', quote.signature_method);

        items.length = 0;
        for (const item of loadedItems) {
          items.push({
            label: item.label,
            description: item.description || '',
            quantity: item.quantity,
            unitPrice: item.unit_price_cents / 100,
          });
        }
        discountInput.value = String((quote.discount_cents || 0) / 100);
        const discountReasonEl = form.querySelector('[data-discount-reason]');
        if (discountReasonEl instanceof HTMLInputElement) discountReasonEl.value = quote.discount_reason || '';
        render();

        form.querySelectorAll('input, select, textarea, button').forEach((el) => {
          if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement || el instanceof HTMLButtonElement) {
            el.disabled = false;
          }
        });
        // A saved quote's type is fixed (the server enforces it too).
        if (mode === 'edit') typeRadios.forEach((radio) => { radio.disabled = true; });
        syncBrandVisibility();
      } catch (error) {
        if (loadErrorEl instanceof HTMLElement) {
          loadErrorEl.hidden = false;
          loadErrorEl.textContent = error instanceof Error ? error.message : 'Could not load that quote.';
        }
        form.hidden = true;
      }
    }

    async function loadFromLead(id: string) {
      form.querySelectorAll('input, select, textarea, button').forEach((el) => {
        if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement || el instanceof HTMLButtonElement) el.disabled = true;
      });
      try {
        const response = await fetch('/internal/api/leads');
        if (!response.ok) throw new Error('Could not load that inquiry.');
        const { leads } = await response.json();
        const lead = leads.find((item: any) => String(item.id) === id);
        if (!lead) throw new Error('That inquiry could not be found. It may have moved beyond the recent inquiry list.');
        setField('name', lead.name);
        setField('phone', lead.phone);
        setField('email', lead.email);
        setField('city', lead.city);
        setField('notes', lead.notes);
        if (lead.role === 'Builder / GC' || lead.role === 'Homeowner') setRadio('role', lead.role);
        // An inquiry from the siding page starts a siding quote (the Start quote link also carries ?type=siding).
        if (lead.service === 'siding' || searchParams.get('type') === 'siding') { workType = 'siding'; applyWorkType(); }
        if (headingEl) headingEl.textContent = `${workType === 'siding' ? 'Siding quote' : 'Quote'} for ${lead.name || 'new customer'}`;
        if (ledeEl) ledeEl.textContent = 'Customer details started from the inquiry. Confirm the address and build the quote.';
        form.querySelectorAll('input, select, textarea, button').forEach((el) => {
          if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement || el instanceof HTMLButtonElement) el.disabled = false;
        });
        syncBrandVisibility();
      } catch (error) {
        if (loadErrorEl instanceof HTMLElement) {
          loadErrorEl.hidden = false;
          loadErrorEl.textContent = error instanceof Error ? error.message : 'Could not load that inquiry.';
        }
        form.hidden = true;
      }
    }

    if (editId) loadForEdit(editId, 'edit');
    else if (duplicateId) loadForEdit(duplicateId, 'duplicate');
    else if (leadId) loadFromLead(leadId);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(status instanceof HTMLElement)) return;
      status.hidden = true;

      if (items.length === 0) {
        status.hidden = false;
        status.textContent = 'Add at least one line item first.';
        return;
      }

      // Re-check every quantity as typed. The per-field handlers keep the last good number in the totals, so a
      // field left empty or fractional must stop the save here rather than save a number the person cannot see.
      const badQty = [...itemsBody.querySelectorAll<HTMLInputElement>('input[data-line-qty]')].find((el) => wholeQuantity(el.value) === null);
      if (badQty) {
        badQty.setAttribute('aria-invalid', 'true');
        status.hidden = false;
        status.textContent = `${QUANTITY_MESSAGE} Fix the highlighted line.`;
        badQty.focus();
        return;
      }

      // A $0 line is easy to miss on a phone and would print as $0.00 on the contract: make Mark say it is on purpose.
      const zeroLines = items.filter(needsPrice);
      if (zeroLines.length > 0 && !window.confirm(`${zeroLines.length} line${zeroLines.length === 1 ? ' is' : 's are'} still $0:\n\n${zeroLines.slice(0, 5).map((item) => `• ${item.label}`).join('\n')}\n\nSave anyway? You can change prices on the next screen.`)) return;

      const data = new FormData(form);
      const discountReasonEl = form.querySelector('[data-discount-reason]');
      const payload = {
        customer: {
          name: data.get('name'),
          phone: data.get('phone'),
          email: data.get('email'),
          address: data.get('address'),
          city: data.get('city'),
          role: data.get('role'),
        },
        notes: data.get('notes'),
        workType,
        items: items.map((item) => ({
          label: item.label,
          description: item.description,
          quantity: item.quantity,
          unitPriceCents: Math.round(item.unitPrice * 100),
        })),
        discountCents: Math.round((Number(discountInput.value) || 0) * 100),
        discountReason: discountReasonEl instanceof HTMLInputElement ? discountReasonEl.value : '',
        signatureMethod: data.get('signatureMethod'),
        // Only a new quote started from an inquiry carries it; edits keep the stored link.
        ...(!editId && leadId && /^\d+$/.test(leadId) ? { leadId } : {}),
      };

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving…';
      }

      try {
        const response = await fetch(
          editId ? `/internal/api/quotes/${encodeURIComponent(editId)}` : '/internal/api/quotes',
          {
            method: editId ? 'PUT' : 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          },
        );
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Could not save the quote.');
        const id = editId || result.id;
        store.del(NOTES_KEY);
        window.location.href = `/internal/quotes/view?id=${encodeURIComponent(id)}`;
      } catch (error) {
        status.hidden = false;
        status.textContent = error instanceof Error ? error.message : 'Could not save the quote.';
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.textContent = editId ? 'Save changes' : 'Save & continue';
        }
      }
    });
  }

  initQuoteBuilder();
  document.addEventListener('astro:page-load', initQuoteBuilder);
</script>

<style>

  .qb-notes-actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-s); }
  .qb-notes-actions .btn { white-space: normal; overflow-wrap: normal; }
  .qb-notes-actions .qb-rec { display: inline-flex; align-items: center; gap: .5rem; }
  .qb-rec-dot { width: .7rem; height: .7rem; border-radius: 50%; background: currentColor; opacity: .55; }
  :global(.qb-rec.qb-rec-live) { background: var(--danger, #9b2c2c); border-color: var(--danger, #9b2c2c); color: #fff; }
  :global(.qb-rec.qb-rec-live .qb-rec-dot) { opacity: 1; animation: qb-rec-pulse 1.2s ease-in-out infinite; }
  @keyframes qb-rec-pulse { 50% { transform: scale(1.35); opacity: .6; } }
  @media (prefers-reduced-motion: reduce) { :global(.qb-rec.qb-rec-live .qb-rec-dot) { animation: none; } }
  .qb-unpriced { margin: var(--space-s) 0 0; padding: .5rem .7rem; border-radius: var(--radius-md); border: 1px solid var(--danger, #9b2c2c); }
  .qb-mic { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-s); margin-top: var(--space-s); }
  .qb-mic label { flex: 1 1 14rem; }
  .qb-mic select { width: 100%; }
  .qb-sizes { margin: var(--space-s) 0 0; padding: .5rem .7rem; border-radius: var(--radius-md); border: 1px solid var(--line-strong); font-variant-numeric: tabular-nums; }
  .qb-sizes strong { white-space: nowrap; }
  .qb-measure-list { margin: 0 0 var(--space-s); padding-left: 1.2rem; font-variant-numeric: tabular-nums; }
  .qb-level { height: .5rem; margin-top: var(--space-s); border-radius: 999px; background: var(--line); overflow: hidden; }
  .qb-level span { display: block; height: 100%; width: 100%; background: var(--accent, #1f6f43); transform-origin: left; transform: scaleX(0); transition: transform .08s linear; }
  @media (prefers-reduced-motion: reduce) { .qb-level span { transition: none; } }
  /* The shared .choice rule never wraps; these labels are sentences. */
  .qb-auto { display: flex; align-items: flex-start !important; gap: .5rem; margin-top: var(--space-s); white-space: normal !important; }
  [data-rough-notes] { width: 100%; }
  .qb-note-status { margin: var(--space-s) 0 0; padding: .5rem .7rem; border-radius: var(--radius-md); background: var(--paper-raised); border: 1px solid var(--line-strong); }
  .qb-note-status.qb-note-problem { border-color: var(--danger, #9b2c2c); }
  :global(.qb-items tr.qb-row-unpriced .qb-cell-price input) { border-color: var(--danger, #9b2c2c); background: color-mix(in srgb, var(--danger, #9b2c2c) 8%, transparent); }
  #quote-form {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-l);
  }

  .qb-block {
    min-width: 0; /* a fieldset otherwise grows to its widest child and pushes the page sideways on a phone */
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-m);
    display: grid;
    gap: var(--space-s);
  }

  .qb-block legend {
    font-weight: 600;
    padding: 0 var(--space-2xs);
  }

  .qb-block label {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .qb-block input,
  .qb-block select,
  .qb-block textarea {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.55rem;
    font: inherit;
    font-size: var(--step-0);
  }

  .qb-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
  }

  .qb-role {
    border: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
  }

  .qb-role .choice {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 400;
  }

  .qb-catalog-row,
  .qb-custom-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
    gap: var(--space-s);
    align-items: end;
  }

  .qb-catalog-row label.is-disabled {
    opacity: 0.5;
  }

  .qb-items {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .qb-items th {
    text-align: left;
    padding: 0.3rem 0.4rem;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--step--2);
  }

  /* The tbody rows below are built at runtime from the items array (one
     render() per add/edit/remove), so they never get Astro's scoping
     attribute — these rules have to be :global() or they silently only
     ever match zero elements. */
  :global(.qb-items td) {
    padding: 0.3rem 0.4rem;
    border-bottom: 1px solid var(--line);
  }

  :global(.qb-items td:first-child input) {
    width: 100%;
  }

  :global(.qb-items td input[type='number']) {
    width: 5rem;
  }

  :global(.qb-line-total) {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  :global(.qb-remove) {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    width: 1.8rem;
    height: 1.8rem;
    cursor: pointer;
    color: var(--danger);
  }

  .qb-totals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    align-items: end;
    margin-top: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .qb-discount input {
    max-width: 10rem;
  }

  .qb-total-line {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    font-size: var(--step--1);
  }

  .qb-total-line-final {
    font-size: var(--step-1);
    font-weight: 600;
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
  }

  .qb-sig-choice {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
  }

  .qb-sig-choice .choice {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .qb-status {
    color: var(--danger);
    border-left: 2px solid var(--danger);
    padding-left: var(--space-2xs);
    margin: 0;
  }

  @media (max-width: 700px) {
    .qb-grid-2,
    .qb-catalog-row,
    .qb-custom-row {
      grid-template-columns: 1fr;
    }

    /* Each line becomes a small card: description on its own row, then qty / unit price, then total / remove. */
    .qb-items thead {
      display: none;
    }

    .qb-items,
    .qb-items tbody {
      display: block;
    }

    :global(.qb-items tbody tr) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.4rem 0.6rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--line);
    }

    :global(.qb-items td) {
      padding: 0;
      border-bottom: 0;
      min-width: 0;
    }

    :global(.qb-items td[data-cap]::before) {
      content: attr(data-cap);
      display: block;
      font-size: var(--step--2);
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    :global(.qb-cell-label) {
      grid-column: 1 / -1;
    }

    :global(.qb-items td input[type='number']) {
      width: 100%;
      box-sizing: border-box;
    }

    :global(.qb-cell-remove) {
      justify-self: end;
      align-self: end;
    }
  }

  /* Phone: a dock above the bottom navigation, so the number being built is always in view. */
  .qb-dock { display: none; }
  @media (max-width: 680px) {
    .qb-dock {
      display: flex; align-items: center; justify-content: space-between; gap: var(--space-s);
      position: sticky; bottom: calc(4.6rem + env(safe-area-inset-bottom)); z-index: 5;
      margin-top: var(--space-m); padding: .6rem .75rem;
      border: 1px solid var(--line-strong); border-radius: var(--radius-lg);
      background: var(--paper-raised); box-shadow: var(--shadow-md);
    }
    .qb-dock[hidden] { display: none; }
    .qb-dock-total { font-size: var(--step-1); font-weight: 650; display: grid; line-height: 1.1; }
    .qb-dock-total output { font-variant-numeric: tabular-nums; }
