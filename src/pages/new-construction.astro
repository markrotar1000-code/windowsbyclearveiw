---
import { getHeroBg } from '../lib/hero-bg';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { SLOT_SIZES, frameForGroup } from '../lib/image-sizes';
import { newBuildWork, newBuildGableWork, findWork, workKindLabel } from '../data/work';

// Both new-build photos are wider than tall, so they get a landscape frame instead of a cropped strip.
const newBuildFrame = frameForGroup(newBuildWork);
const gableFrame = frameForGroup(newBuildGableWork);
import { site, mailHref, telHref } from '../data/site';

const ogPhoto = findWork('new-build-sheathed-garage')!;

// Full-bleed hero background: a real new-construction job.
const heroPhoto = findWork('new-build-tan-corner')!;
const heroBg = await getHeroBg(heroPhoto.image);

// Mirrors the numbered list below exactly — if the sequence changes, this
// must change with it, or the markup and the schema will say different
// things. See process.astro for the homeowner-side equivalent.
const sequence = [
  {
    name: 'Review the plans',
    text: 'Send your plans or window list. We check the number of windows, their sizes, and the styles you want.',
  },
  {
    name: 'Write the estimate',
    text: 'We give you a written price and the manufacturer’s expected delivery time before ordering.',
  },
  {
    name: 'Check the openings',
    text: 'We check the framed spaces for the windows against the manufacturer’s requirements before installation.',
  },
  {
    name: 'Install the windows',
    text: 'We install after the outside wall panels and protective wrap are in place, before the siding or stucco goes on.',
  },
  {
    name: 'Walk through the work',
    text: 'We check the installed windows with you or your builder before the next work begins.',
  },
];

// Page-specific captions keep the shared gallery wording unchanged.
const captions: Record<string, string> = {
  'new-build-sheathed-garage': 'Windows on a two-story house before siding',
  'new-build-tan-corner': 'Black-framed windows on a new house',
  'new-build-gable-windows-roofline': 'Triangular windows below the roof',
  'new-build-gable-windows-grid-picture-window': 'Triangular windows above a large window with grids',
  'new-build-gable-windows-over-trimmed-grid': 'Windows above the new siding',
  'new-build-flashing-tape-grid-window-ladder': 'Protective tape around the windows',
  'new-build-gable-windows-flashing-ladder': 'Windows and wall wrap before siding',
};

const rowSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Clearview installs windows on a new home',
  description: 'From reviewing the plans to checking the finished window installation.',
  step: sequence.map((step) => ({
    '@type': 'HowToStep',
    name: step.name,
    text: step.text,
  })),
};

// Same shape as the per-city Service schema in areas/[slug].astro, scoped to
// this service rather than one town. The sitewide hasOfferCatalog entry
// (JsonLd.astro) is just a name + url; this gives the service its own
// describable entity, so it is additive rather than a duplicate.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'New construction window installation',
  name: 'New construction window installation',
  description:
    'Window installation for new homes in Clark County, planned with your builder.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: site.nearby.map((place) => ({
    '@type': 'City',
    name: place.name,
    containedInPlace: { '@type': 'State', name: place.state },
  })),
};

const schema = { '@context': 'https://schema.org', '@graph': [serviceSchema, rowSchema] };

// mailHref() falls back to /estimate when site.email is unset — appending a
// mailto-style query string to that would silently get ignored by
// EstimateForm, dropping the builder role prefill along with it. Route the
// no-email case through ?role=builder instead so the fallback still lands
// where it's supposed to.
const projectInquiryMailto = site.email
  ? mailHref() + `?subject=${encodeURIComponent('New construction window estimate')}` +
    `&body=${encodeURIComponent('Project address:\nBuilder or company name:\nNumber of windows:\nPlanned installation date:\n\n(Attach your plans or window list if you have one.)')}`
  : '/estimate?role=builder';
---
<BaseLayout
  title="New construction windows for builders"
  description="Window installation for new homes in Clark County. Send your plans or window list for a written estimate and help planning the installation."
  path="/new-construction"
  crumbs={[{ name: 'New construction', href: '/new-construction' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
  schema={schema}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">For new homes</p>
      <h1>Window installation for new homes.</h1>
      <p class="lede">
        We install windows and siding for new homes. Send us your plans or window list. We check what you need, give you a written estimate, and plan the installation with your builder.
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href={projectInquiryMailto}>Send your plans</a>
        <a class="btn btn-ghost btn-on-dark" href={telHref()}>Call {site.phoneDisplay}</a>
      </div>
      <p class="hero-note">
        We also offer <a href="/siding">siding installation</a>. Replacing windows in an existing home? <a href="/replacement">Window replacement</a>. Patio doors?{' '}
        <a href="/sliding-glass-doors">Sliding glass doors</a>.
      </p>
    </div>
    <p class="hero-photo-credit">Clearview job photo — windows on a new house</p>
  </section>

  <section class="section">
    <div class="wrap split" data-reveal>
      <article>
        <p class="rule-label">Planning your installation</p>
        <h2>From plans to install.</h2>
        <p>
          We review your plans and check the window sizes and styles. You get a written estimate and the manufacturer's expected delivery time. We then arrange installation around your building schedule.
        </p>
      </article>
      <article>
        <p class="rule-label">Contractor registration</p>
        <p>
          {site.legalName} · WA UBI {site.ubiNumber} · L&amp;I {site.lniNumber}.{' '}
          <a href="https://secure.lni.wa.gov/verify/" target="_blank" rel="noopener noreferrer">
            Verify registration
          </a>.
        </p>
      </article>
    </div>
  </section>

  <section class="section section-sunk" id="schedule">
    <div class="wrap split" data-reveal>
      <article>
        <p class="rule-label">Getting an estimate</p>
        <h2>Send us your plans or window list.</h2>
        <p>Include the details below. If something is missing or does not agree with the plans, we check it with you before ordering.</p>
      </article>
      <article>
        <p class="rule-label">What to send</p>
        <ul class="plain-list">
          <li>Number of windows, their sizes, and how each one opens</li>
          <li>Preferred brand, frame color, and any glass requirements</li>
          <li>Project address, contact person, and planned installation date</li>
        </ul>
        <p class="fine-print">
          <a href="/window-features">Window and glass options</a>
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Before installation</p>
      <h2>Getting the walls ready.</h2>
      <div class="ro-notes">
        <article>
          <h3>Window openings</h3>
          <p>
            The framed spaces for the windows need to meet the manufacturer’s size and installation requirements.
          </p>
        </article>
        <article>
          <h3>Outside walls</h3>
          <p>
            The outside wall panels and protective wrap need to be in place before we install the windows.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">The steps</p>
      <h2>How the job works.</h2>
      <ol class="steps">
        {sequence.map((step) => (
          <li><strong>{step.name}.</strong> {step.text}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Site preparation</p>
      <h2>Before we install the windows.</h2>
      <ul class="plain-list">
        <li>Have the wall panels and house wrap in place, and keep each window opening clear.</li>
        <li>Plan siding or stucco work after we install and check the windows.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap newbuild-band" data-reveal>
      <div>
        <p class="rule-label">Completed work</p>
        <h2>Windows on new homes.</h2>
        <p class="lede">
          Photos from our new-construction jobs.
        </p>
        <p class="section-link"><a href="/gallery">See more project photos</a></p>
      </div>
      <div class="work-grid work-grid-newbuild">
        {newBuildWork.map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={captions[photo.id] ?? photo.caption}
            kind={workKindLabel(photo.kind)}
            sizes={SLOT_SIZES.fullThenBeside}
            frame={newBuildFrame}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">Window details</p>
      <h2>Windows before the siding goes on.</h2>
      <div class="work-grid work-grid-gable">
        {newBuildGableWork.map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={captions[photo.id] ?? photo.caption}
            sizes={SLOT_SIZES.threeAcross}
            frame={gableFrame}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="project-inquiry">
    <div class="wrap is-narrow" data-reveal>
        <p class="rule-label">Get in touch</p>
        <h2>Ask for an estimate.</h2>
      <ol class="steps">
        <li>
          <strong>Email your plans.</strong> Send your plans or window list to{' '}
          <a href={projectInquiryMailto}>{site.email}</a>.
        </li>
        <li>
          <strong>Use the estimate form.</strong> Choose "Builder or GC" and tell us where the project is and what you need.{' '}
          <a href="/estimate?role=builder">Request an estimate</a>.
        </li>
      </ol>
      <p class="fine-print">
        Get the price in writing before you order.
      </p>
    </div>
  </section>

  <CtaBar
    heading="Planning a new build?"
    body="Send your plans or window list, or call us to talk through the project."
    showToolLink={false}
  />
</BaseLayout>

<style>
  /* Full-bleed photo hero, a real Clearview job. */
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: var(--space-m) 0 0;
  }

  /* Cross-link to the other service page, set into the dark hero. The global
     `a { color: var(--ink) }` reads as invisible on this background, so the
     link gets its own on-dark treatment rather than inheriting it. */
  .hero-note {
    margin: var(--space-m) 0 0;
    max-width: 44rem;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .hero-note a {
    color: var(--on-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent-bright);
    text-underline-offset: 0.2em;
  }

  .hero-note a:hover,
  .hero-note a:focus-visible {
    color: var(--accent-bright);
  }

  /* Keep the two preparation notes readable at desktop and phone sizes. */
  .ro-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin: var(--space-l) 0 0;
  }

  .ro-notes article {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .ro-notes h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
  }

  .ro-notes p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* A single tall framing shot needs a partner, not a full-width grid row of
     its own — stretched across the page it read as a missing image. */
  .newbuild-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    gap: var(--space-xl);
    align-items: center;
  }

  @media (max-width: 900px) {
    .newbuild-band {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }

    .ro-notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
