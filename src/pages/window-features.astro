---
import { Image } from 'astro:assets';
import heroInstallationPhoto from '../assets/work/window-features-installation-4k.png';
import vinylFiberglassGraphic from '../assets/guides/vinyl-fiberglass-guide.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import WindowStudio from '../components/WindowStudio.astro';
import CtaBar from '../components/CtaBar.astro';
import ColumbiaMediaCard from '../components/ColumbiaMediaCard.astro';
import { styleMedia } from '../data/columbia-media';
import { pricing, publicBlurb } from '../data/pricing';
import { findWork } from '../data/work';
import CanvaGuideEmbed from '../components/CanvaGuideEmbed.astro';
import energyRatingsGraphic from '../assets/guides/window-energy-ratings-explained.png';

const ogPhoto = findWork('stone-craftsman')!;

const materials = pricing.materials;
const brands = pricing.brands;
const styles = pricing.openings.filter((opening) => !opening.isDoor);
const doors = pricing.openings.filter((opening) => opening.isDoor);

---
<BaseLayout
  title="Window features"
  description="What's in a Clearview window: vinyl or fiberglass, Columbia, Cascade or Milgard, the glass package, and every style we install for Washington homes."
  path="/window-features"
  crumbs={[{ name: 'Window features', href: '/window-features' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
>
  <section class="page-hero page-hero-photo">
    <div class="wrap hero-installation-layout">
      <div class="hero-copy">
      <p class="kicker">Window features</p>
      <h1>Find the right window for your home.</h1>
      <p class="lede">
        Compare opening styles, understand glass and frame options, and explore real product details from Columbia Windows.
      </p>
      <nav class="features-jumps" aria-label="Explore window features"><a href="#window-studio">Opening styles ↓</a><a href="#materials">Frames &amp; glass ↓</a><a href="/columbia-windows#technology">Columbia technology →</a></nav>
      </div>
      <figure class="hero-installation-photo">
        <Image src={heroInstallationPhoto} alt="Clearview crew installing a white window beneath an arched transom on a house with taupe siding and a brick base." widths={[450, 750, 1050, 1500]} sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 1000px) 42vw, 420px" format="webp" quality={88} loading="eager" fetchpriority="high" />
        <figcaption class="hero-photo-credit">Clearview job photo — exterior window installation</figcaption>
      </figure>
    </div>
  </section>

  <WindowStudio />

  <section class="section section-sunk" id="materials">
    <div class="wrap" data-reveal>
      <p class="rule-label">What it's made of</p>
      <h2>Vinyl or fiberglass.</h2>
      <div class="compare">
        {materials.map((material) => (
          <article class="compare-card">
            <h3>{material.label}</h3>
            <p class="compare-blurb">{publicBlurb(material)}</p>
          </article>
        ))}
      </div>
      <div class="diagram-slot">
        <figure class="frame-materials-graphic">
          <Image
            src={vinylFiberglassGraphic}
            alt="Vinyl versus fiberglass window frames: cross-sections of a white chambered PVC frame and a dark glass-fiber-reinforced resin frame, with notes on frame construction, when the material matters, and what you may notice. Illustrative profiles only."
            widths={[760, 1140, 1536]}
width={1536}
            sizes="(max-width: 800px) 100vw, 1240px"
            quality={82}
            loading="lazy"
          />
        </figure>
      </div>
      <p class="fine-print">
        We install both. Vinyl suits most standard openings; fiberglass suits wide sliders and
        picture windows that might otherwise flex.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Which window</p>
      <h2>Columbia, Cascade, and Milgard.</h2>
      <p class="lede">Columbia Windows is one of our main suppliers. <a href="/columbia-windows">Explore Victory, Synergy, and Nova with photos, diagrams, and specifications.</a></p>
      <div class="compare">
        {brands.map((brand) => (
          <article class="compare-card">
            <h3>{brand.label}</h3>
            <p class="compare-blurb">{publicBlurb(brand)}</p>
          </article>
        ))}
      </div>
      <p class="fine-print">
        The installation is done to the same standard across brands; the window in the opening is
        different. We tell you which one a quote is based on, and why, before anything is ordered.{' '}
        <a href="/guides/cascade-vs-milgard">Cascade vs Milgard: where each is made, how they differ, and when the step up is worth it.</a>
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Glass</p>
      <h2>Double- or triple-pane, Low-E either way.</h2>
      <p>
        Every window we install has an insulated glass package, double- or triple-pane, with a
        Low-E coating chosen for a Pacific Northwest heating season.
      </p>
      <p>
        A cloudy or fogged pane is a different problem: a failed seal, not a coating choice. <a href="/guides/fogged-windows">How to tell the difference</a>.
      </p>
      <div class="diagram-slot">
        <CanvaGuideEmbed
          desktopSrc={energyRatingsGraphic}
          widths={[1000, 1400, 1536]}
          alt="Window Energy Ratings, Explained. U-factor measures heat transfer: how well the window insulates. Lower means better insulation, because less heat passes through the window; U-factor is not an air-leakage rating. SHGC, the solar heat gain coefficient, measures how much solar heat enters: a lower SHGC admits less of the sun's heat and a higher SHGC admits more, and the right balance depends on the home. What matters for your home: climate, balancing winter heat retention with summer comfort; orientation and shade, meaning which way windows face and how much sun reaches them; and whole-window ratings, comparing NFRC ratings for the complete window. Start with good insulation, then choose solar heat gain for the room, exposure and shading."
          title="Window energy ratings: U-factor and SHGC"
          description="Conceptual illustrations. Confirm product ratings and current utility rebate requirements before selecting windows."
        />
      </div>
    </div>
  </section>


  <section class="section" id="styles">
    <div class="wrap is-wide" data-reveal>
      <p class="rule-label">Shapes and operation</p>
      <h2>Window styles.</h2>

      <div class="style-list">
        {styles.map((style) => (
          <article class="style-row">
            <h3>{style.label}</h3>
            <p>{style.blurb}</p>
          </article>
        ))}
      </div>

      <h3 class="supplier-styles-heading">Columbia opening styles, illustrated.</h3>
      <p class="fine-print">Original supplier illustrations. Configurations and availability depend on the series.</p>
      <div class="supplier-styles">{styleMedia.map(media => <ColumbiaMediaCard {...media} />)}</div>

      <p class="fine-print">
        Arches, transoms, and other non-rectangular openings are measured and priced
        individually.
        {doors.length > 0 && (
          <>
            {' '}Doors — {doors.map((door) => door.label.toLowerCase()).join(' and ')} — are not
            windows, but we can install them as part of the same project if you are doing a whole
            side of the house. More on <a href="/sliding-glass-doors">sliding glass doors</a>.
          </>
        )}
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Hardware and color</p>
      <h2>Make the details your own.</h2>
      <p>
        Locking hardware, interior and exterior color, and grid patterns depend on the line we
        order, and each manufacturer offers a different selection. Explore Columbia’s finish technology, grille patterns, and hardware details before discussing your choices with us.
      </p>
      <a class="btn btn-secondary" href="/columbia-windows#product-details">See finishes, grilles &amp; hardware →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Warranty</p>
      <h2>What the warranty covers.</h2>
      <p>
        The glass and hardware carry the manufacturer's own warranty, and each manufacturer
        writes its terms differently. Review the manufacturer's paperwork for coverage,
        duration, and contact information. Customers contact the manufacturer directly and
        handle any manufacturer warranty claim; Clearview does not handle or assist with those claims.
      </p>
    </div>
  </section>

  <CtaBar
    heading="Get your zero pressure quote."
    body="The right material, brand, and style depend on the house. Call for your quote today. Nothing is ordered until you are ready."
  />
</BaseLayout>

<style>
  .features-jumps { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-m); }
  .features-jumps a { padding: .7rem .9rem; border: 1px solid currentColor; border-radius: var(--radius); font-size: var(--step--1); color: inherit; }
  .supplier-styles-heading { margin-top: var(--space-l); }
  .supplier-styles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-s); }
  @media (max-width: 900px) { .supplier-styles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .supplier-styles { grid-template-columns: minmax(0, 1fr); } }

  .frame-materials-graphic {
    margin: var(--space-l) 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper-raised);
    box-shadow: var(--shadow-soft);
  }

  .frame-materials-graphic img {
    display: block;
    width: 100%;
    height: auto;
  }

  .page-hero-photo {
    padding: var(--space-xl) 0;
  }

  .hero-installation-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    align-items: center;
    gap: var(--space-xl);
  }

  .hero-installation-photo {
    margin: 0;
    min-width: 0;
  }

  .hero-installation-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .hero-photo-credit {
    margin: var(--space-xs) 0 0;
    text-align: center;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.85;
  }

  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin: var(--space-l) 0 var(--space-m);
  }

  .diagram-slot {
    margin: var(--space-l) 0;
  }

  .compare-card {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .compare-card h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
  }

  .compare-blurb {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .style-list {
    margin: var(--space-l) 0 0;
    border-top: 1px solid var(--line);
  }

  .style-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-m);
    align-items: baseline;
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--line);
  }

  .style-row h3 {
    margin: 0;
    font-size: var(--step-0);
  }

  .style-row p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .style-photos {
    margin-top: var(--space-l);
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 900px) {
    .hero-installation-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
      gap: var(--space-m);
    }

    .compare {
      grid-template-columns: minmax(0, 1fr);
    }

    .style-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3xs);
    }

    .style-photos {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 700px) {
    .hero-installation-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-installation-photo {
      width: min(100%, 420px);
      justify-self: center;
    }
  }
</style>
