---
import { getHeroBg } from '../lib/hero-bg';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { SLOT_SIZES, frameForGroup } from '../lib/image-sizes';
import GalleryAddition from '../components/GalleryAddition.astro';
import { galleryAdditions } from '../data/gallery-additions';
import CtaBar from '../components/CtaBar.astro';
import { allWork, findWork, workKindLabel } from '../data/work';
import { site } from '../data/site';
import FacebookIcon from '../components/icons/FacebookIcon.astro';

const ogPhoto = findWork('green-craftsman-upper')!;

// A real job photo for the hero, not stock or AI -- the page's own copy
// promises exactly that ("None of it is stock"), so the hero has to keep it.
const heroBg = await getHeroBg(ogPhoto.image);

// Grouped rather than poured into one long grid: 26 tiles in a single field
// is a contact sheet, not a portfolio. The groups also let a builder skip
// straight to framing shots.
// Group density controls presentation; responsive images use 4K sources.
const groups = [
  {
    id: 'elevations',
    label: 'From the street',
    blurb: 'What the new windows look like from outside.',
    density: 'is-large',
    photos: allWork.filter((photo) => photo.kind === 'after'),
  },
  {
    id: 'interiors',
    label: 'From inside the room',
    blurb: 'What the windows look like from inside the room.',
    density: 'is-square',
    photos: allWork.filter((photo) => photo.kind === 'interior'),
  },
  {
    id: 'install-day',
    label: 'Install day',
    blurb: 'Photos taken while the windows are going in.',
    density: 'is-dense',
    photos: allWork.filter((photo) => photo.kind === 'process'),
  },
  {
    id: 'new-construction',
    label: 'New construction',
    blurb: 'Windows going into new homes.',
    density: 'is-large',
    photos: allWork.filter((photo) => photo.kind === 'new construction'),
  },
  {
    id: 'siding',
    label: 'Siding',
    blurb: 'Siding work, some of it photographed before it was finished.',
    density: 'is-dense',
    photos: allWork.filter((photo) => photo.kind === 'siding'),
  },
]
  .filter((group) => group.photos.length > 0)
  .map((group) => ({
    ...group,
    // Interiors are room shots that survive a square crop; a group of only landscape photos
    // (siding, new construction) gets a landscape frame so the whole building shows; the rest
    // keep the portrait frame. The frame also decides which file the browser downloads.
    frame: group.density === 'is-square' ? ('square' as const) : frameForGroup(group.photos),
    sizes:
      group.photos.length === 1
        ? SLOT_SIZES.single
        : group.density === 'is-dense'
          ? SLOT_SIZES.fourAcross
          : SLOT_SIZES.threeAcross,
  }));

---
<BaseLayout
  title="Window Replacement Project Photos"
  description="Real window replacement and new-construction jobs in Vancouver, WA and Clark County. Book a free in-home measure and get a written estimate."
  path="/gallery"
  crumbs={[{ name: 'Gallery', href: '/gallery' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">Gallery</p>
      <h1>Real jobs, real photos.</h1>
      <p class="lede">
        Photos of new windows, sliding doors and siding on homes around Washington.
      </p>
      <p class="gallery-index">
        <span>
          <a href="#more-projects">More photos</a> · {' '}
          {groups.map((group, index) => (
            <>
              <a href={`#${group.id}`}>{group.label.toLowerCase()}</a>
              {index < groups.length - 1 ? ' · ' : ''}
            </>
          ))}
        </span>
      </p>
      {site.social.facebook && (
        <p class="gallery-social">
          <a class="inline-social" href={site.social.facebook} target="_blank" rel="noopener noreferrer">
            <FacebookIcon class="inline-social-icon" />
            We post more photos on Facebook
          </a>
        </p>
      )}
    </div>
  </section>

  <section class="section gallery-lead" id="more-projects">
    <div class="wrap is-wide" data-reveal>
      <div class="group-head">
        <div>
          <p class="rule-label">More photos</p>
          <h2>Windows and sliding doors, inside and out.</h2>
        </div>
      </div>
      <div class="work-grid is-large">
        {galleryAdditions.map((photo, index) => <GalleryAddition {...photo} eager={index < 3} />)}
      </div>
    </div>
  </section>

  {groups.map((group, groupIndex) => (
    <section class:list={['section', groupIndex % 2 === 1 && 'section-sunk']} id={group.id}>
      <div class="wrap is-wide" data-reveal>
        <div class="group-head">
          <div>
            <p class="rule-label">{group.label}</p>
            <h2>{group.blurb}</h2>
          </div>
        </div>
        {/* A lone photo in a three-column grid is not a large tile, it is a
            hole with a picture in the corner. Constrain it instead. */}
        <div class:list={['work-grid', group.photos.length === 1 ? 'is-single' : group.density]}>
          {group.photos.map((photo, index) => (
            <WorkCard
              image={photo.image}
              alt={photo.alt}
              caption={photo.caption}
              kind={workKindLabel(photo.kind)}
              sizes={group.sizes}
              frame={group.frame}
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaBar
    heading="Want yours in here?"
    body="We measure every opening before quoting, and you can ask to see a job like yours nearby."
  />
</BaseLayout>

<style>
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  /* The photos are the point of this page, and at 1440x900 the first row started
     at y=774 (126 px visible), at 1280x720 and on a 390x844 phone not at all.
     Less air above them so the best photos show without scrolling. */
  .page-hero-photo {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-l);
  }

  .gallery-lead {
    padding-top: var(--space-xl);
  }

  .gallery-lead .group-head {
    margin-bottom: var(--space-m);
  }

  /* A jump index in the hero: 26 tiles down one page is a long scroll for a
     builder who only wants the framing shots. */
  /* The link list re-wraps when Outfit replaces the fallback — metric matching
     keeps block heights honest but cannot hold line breaks in place, since the
     glyph widths differ. Measured at 0.016 CLS, which is well inside the 0.1
     "good" threshold. Reserving the container height and restructuring to a
     grid were both tried and changed nothing, because the links still reflow
     within whatever box they are given. Left alone deliberately. */
  .gallery-index {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    margin: var(--space-m) 0 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--dark-line);
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .gallery-index a {
    color: var(--on-dark-soft);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--dark-line-strong);
  }

  .gallery-index a:hover {
    color: var(--on-dark);
    text-decoration-color: currentColor;
  }

  .gallery-social {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .gallery-social a {
    color: var(--on-dark-soft);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--dark-line-strong);
  }

  .gallery-social a:hover {
    color: var(--on-dark);
    text-decoration-color: currentColor;
  }

  /* Per-group scale. The column counts keep every tile at or below the 450px
     source width at the widths this page is read at. */
  .work-grid.is-large {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .work-grid.is-square {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .work-grid.is-dense {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2xs);
  }

  .work-grid.is-single {
    grid-template-columns: minmax(0, 22rem);
  }

  /* The frame shape (portrait, landscape, square) is set per group through
     WorkCard's `frame` prop, so the ratio and the file the browser downloads
     always agree. Interiors get a square frame: room shots survive that crop
     better than an elevation does, which loses the roofline when cropped short. */

  @media (max-width: 900px) {
    .work-grid.is-large,
    .work-grid.is-square {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work-grid.is-dense {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .work-grid.is-large,
    .work-grid.is-square,
    .work-grid.is-dense {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work-grid.is-single {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .group-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }

  .group-head h2 {
    margin: 0;
    font-size: var(--step-3);
  }

  /* No photo counts anywhere on this page: a number next to a gallery reads as the
     number of jobs Clearview has done (Keith, 2026-10-11). test:image-delivery fails on one. */
</style>
