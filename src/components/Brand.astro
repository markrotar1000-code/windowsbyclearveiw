---
// Keep the accessible name aligned with both visible lines (WCAG 2.5.3).
// The explicit space joins the flex items for assistive technology.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<a
  class:list={['brand', compact && 'is-compact']}
  href="/"
  aria-label="ClearView Windows and Trim home"
>
  <img
    class="brand-mark"
    src="/logo/icon-mark@128.webp?v=20261028"
    srcset="/logo/icon-mark@64.webp?v=20261028 64w, /logo/icon-mark@128.webp?v=20261028 128w, /logo/icon-mark@256.webp?v=20261028 256w"
    sizes={compact ? '38px' : '44px'}
    width="256"
    height="256"
    alt=""
    loading="eager"
    decoding="async"
  />
  <span class="brand-type">
    <strong>ClearView</strong>{' '}
    <span class="brand-sub">Windows and Trim</span>
  </span>
</a>

<style>
  /* The mark and wordmark travel together, so they are styled here rather
     than by whichever parent happens to contain them. The compact variant is
     the footer's — Astro scoping means a parent cannot reach in to restyle
     these elements, which is the point. */
  .brand {
    display: flex;
    align-items: center;
    /* The wordmark may give way before the Menu button does (large text on a phone). */
    min-width: 0;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--on-dark);
  }

  .brand-mark {
    width: 44px;
    height: 44px;
    flex: none;
    display: block;
    object-fit: contain;
    transition: transform var(--dur) var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: translateY(-1px) rotate(-1.5deg);
  }

  .brand-type {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.05;
  }

  .brand-type strong {
    font-family: Outfit, 'Outfit Fallback', system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.065em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand-sub {
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    margin-top: 0.22rem;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--on-dark-faint);
    font-weight: 500;
  }

  .brand.is-compact {
    color: var(--ink);
  }

  .brand.is-compact .brand-mark {
    width: 38px;
    height: 38px;
  }

  .brand.is-compact .brand-sub {
    color: var(--ink-soft);
  }

  /* At enlarged text sizes, keep the company name on one line and let the
     service line yield before the Menu button. The accessible name stays complete. */
  @container header-row (max-width: 15rem) {
    .brand:not(.is-compact) {
      gap: min(0.7rem, 10px);
    }

    .brand:not(.is-compact) .brand-sub {
      display: none;
    }

    .brand:not(.is-compact) .brand-type strong {
      font-size: min(1.05rem, 22px);
      overflow-wrap: normal;
    }
  }
</style>
