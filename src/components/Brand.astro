---
// The link's accessible name must contain its visible text ("Clearview" and,
// above 380 px, "Vancouver, WA") or a voice-control user who says what they
// see ("click Clearview Vancouver") cannot activate it (WCAG 2.5.3, axe:
// label-content-name-mismatch). The old label said "Clearview Windows home",
// which dropped "Vancouver, WA". The explicit space between the two lines of
// the wordmark matters: they are separate flex items, so nothing renders it,
// but assistive-tech and axe read the text as "ClearviewVancouver, WA" without
// it. scripts/test-a11y-names.mjs guards this.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<a
  class:list={['brand', compact && 'is-compact']}
  href="/"
  aria-label="Clearview Vancouver, WA home"
>
  <img
    class="brand-mark"
    src="/logo/icon-mark@256.webp"
    width="256"
    height="256"
    alt=""
    loading="eager"
    decoding="async"
  />
  <span class="brand-type">
    <strong>Clearview</strong>{' '}
    <span class="brand-sub">Vancouver, WA</span>
  </span>
</a>

<style>
  /* The mark and wordmark travel together, so they are styled here rather
     than by whichever parent happens to contain them. The compact variant is
     the footer's — Astro scoping means a parent cannot reach in to restyle
     these elements, which is the point. */
  .brand {
    display: flex;
    align-items: center;
    /* The wordmark may give way before the Menu button does (large text on a phone). */
    min-width: 0;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--on-dark);
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    flex: none;
    display: block;
    object-fit: contain;
    transition: transform var(--dur) var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: translateY(-1px) rotate(-1.5deg);
  }

  .brand-type {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.05;
  }

  .brand-type strong {
    font-family: Outfit, 'Outfit Fallback', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .brand-sub {
    font-size: 0.62rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-dark-faint);
    font-weight: 500;
  }

  .brand.is-compact {
    color: var(--ink);
  }

  .brand.is-compact .brand-mark {
    width: 34px;
    height: 34px;
  }

  .brand.is-compact .brand-sub {
    color: var(--ink-soft);
  }

  @media (max-width: 380px) {
    .brand:not(.is-compact) .brand-sub {
      display: none;
    }
  }

  /* Large text on a phone, measured by the header row's width in rem (the row is the
     `header-row` container set in Header.astro). At 200% the row is ~294px and the wordmark plus
     "VANCOUVER, WA" plus the Menu button need ~350, so the wordmark was broken mid-word
     ("Clearv/iew"). Keep the wordmark whole and a little smaller, and drop the place line; the
     link's accessible name still contains "Vancouver, WA". */
  @container header-row (max-width: 15rem) {
    .brand:not(.is-compact) {
      gap: min(0.7rem, 10px);
    }

    .brand:not(.is-compact) .brand-sub {
      display: none;
    }

    .brand:not(.is-compact) .brand-type strong {
      font-size: min(1.05rem, 22px);
      overflow-wrap: normal;
    }
  }
</style>
