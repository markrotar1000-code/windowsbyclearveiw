---
import { getImage } from 'astro:assets';
import { site, telHref } from '../data/site';
import { heroPhoto } from '../data/work';
import LicenseTag from './LicenseTag.astro';
import InsuranceTag from './InsuranceTag.astro';
import BondTag from './BondTag.astro';
import GoogleReviewBadge from './GoogleReviewBadge.astro';

// Render the responsive photo immediately, without a decorative reveal video.
const heroStatic = await getImage({
  src: heroPhoto.image,
  widths: [828, 1200, 1600, 2000, 2560],
  width: 1600,
  format: 'webp',
  quality: 66,
});
---
  <section class="video-hero">
    <div class="video-stage" aria-hidden="true">
      <img
        class="hero-static"
        id="hero-static"
        src={heroStatic.src}
        srcset={heroStatic.srcSet.attribute}
        sizes="(max-width: 640px) 160vw, 100vw"
        alt=""
        decoding="sync"
        fetchpriority="high"
      />
      <div class="video-wash"></div>
    </div>

    <div class="wrap video-copy">
      <p class="kicker">
        <img class="kicker-mark" src="/logo/icon-mark@64.webp?v=20261028" srcset="/logo/icon-mark@64.webp?v=20261028 64w, /logo/icon-mark@128.webp?v=20261028 128w, /logo/icon-mark@256.webp?v=20261028 256w" sizes="1.05rem" width="256" height="256" alt="" loading="eager" decoding="async" />
        Vancouver, WA &middot; Clark County
      </p>
      <h1>Great prices. Clean work. Clear windows.</h1>
      <p class="lede">
        Replacement windows, sliding glass doors, and new construction. Window installation and siding done right.
      </p>
      <p class="hero-actions">
        <a class="btn btn-light" href={telHref()}>Call {site.phoneDisplay}</a>
        <a class="btn btn-ghost btn-on-dark" href="/estimate">Request an estimate</a>
      </p>
      <GoogleReviewBadge onDark />
      <p class="hero-credentials"><LicenseTag onDark /><InsuranceTag onDark /><BondTag onDark /></p>
      <p class="hero-note">
        Free in-home measure. Written estimate before anything comes out of the wall.{' '}
        <a href="/tools/window-replacement-cost-calculator">Plan your project first</a>.
      </p>
      <div class="trust-strip-wrap">
        <ul class="trust-strip">
          <li><strong>Clearview</strong><span>quotes every job in person</span></li>
          <li><strong>Both</strong><span>replacement &amp; new construction</span></li>
          <li><strong>Local</strong><span>Vancouver, WA based</span></li>
          <li><strong>Free</strong><span>written estimate, no pressure</span></li>
        </ul>
      </div>
    </div>
  </section>
<style>
  /* ───────────────────────────────────────────────────────────────────────
     The hero carries the whole first impression, so it owns its styling
     outright rather than borrowing shared selectors. Everything here is
     scoped to this component.

     The constraint that shapes it: the source photo is 450px wide. Blown up
     full-bleed it reads as soft. Framed at an honest size, against a large
     dark field and large type, it reads as deliberate.
     ─────────────────────────────────────────────────────────────────────── */
  .hero-static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The hero photo is a tall portrait; 45% keeps both window groups in the
       wide desktop crop instead of sky and gable alone. */
    object-position: 50% 45%;
    opacity: 1;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .hero-static {
      transition: none;
      /* Matches .video-stage .hero-media's mobile crop in global.css. */
      object-position: 50% 2%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-static {
      transition: none;
    }
  }

  .photo-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(
        120% 90% at 82% 12%,
        color-mix(in srgb, var(--accent) 26%, transparent),
        transparent 62%
      ),
      var(--black);
    color: var(--on-dark);
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  /* A very faint diagonal ruling. It gives the flat black field a surface,
     which is what stops the hero reading as an empty box. */
  .photo-hero-grain {
    position: absolute;
    inset: -20%;
    z-index: -1;
    opacity: 0.5;
    background-image: repeating-linear-gradient(
      118deg,
      transparent 0 22px,
      rgb(255 255 255 / 0.022) 22px 23px
    );
    pointer-events: none;
  }

  .photo-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: center;
  }

  .photo-hero-copy,
  .photo-hero-frame {
    min-width: 0;
  }

  .video-copy .kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 var(--space-s);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--on-dark-soft);
  }

  .hero-eyebrow-mark,
  .kicker-mark {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    object-fit: contain;
  }

  .photo-hero-copy h1 {
    max-width: 17ch;
    color: var(--on-dark);
    font-size: var(--step-6);
  }

  /* The second line is the promise, so it gets the accent. `em` rather than a
     span because it is genuinely an emphasis, not decoration. */
  .photo-hero-copy h1 em {
    font-style: normal;
    color: color-mix(in srgb, var(--accent-bright) 78%, var(--on-dark));
  }

  .photo-hero-copy .lede {
    max-width: 34rem;
    color: var(--on-dark-soft);
    margin-bottom: var(--space-m);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0;
  }

  .hero-credentials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-xs) 0 0;
  }

  .hero-note {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .hero-note a {
    color: var(--on-dark);
    text-underline-offset: 0.2em;
  }

  /* Four claims, each a value and a qualifier. The previous version was a row
     of undifferentiated 13px phrases that scanned as filler. */
  /* The wrapper is the container the large-text rule below measures (in rem, so it follows the
     reader's text size). Its margin is the strip's old top margin. */
  .trust-strip-wrap {
    container-type: inline-size;
    margin: var(--space-l) 0 0;
  }

  .trust-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--dark-line-strong);
  }

  .trust-strip li {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-s) var(--space-s) 0;
    border-right: 1px solid var(--dark-line);
  }

  .trust-strip li:first-child {
    padding-left: 0;
  }

  .trust-strip li:last-child {
    border-right: 0;
  }

  .trust-strip strong {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--on-dark);
  }

  .trust-strip span {
    font-size: var(--step--2);
    line-height: 1.4;
    color: var(--on-dark-faint);
  }

  /* The photo sits on a plate with an offset accent rule behind it, so the
     image has an edge and a shadow instead of bleeding into the black. */
  .photo-hero-frame {
    position: relative;
    margin: 0;
    width: 100%;
  }

  .photo-hero-frame::before {
    content: '';
    position: absolute;
    inset: 1.1rem -1.1rem -1.1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent-bright) 55%, transparent);
    border-radius: var(--radius);
    z-index: 0;
  }

  .photo-hero-plate {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--black) 88%, white);
    box-shadow: 0 30px 70px rgb(0 0 0 / 0.55);
  }

  .photo-hero-plate img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 52% 38%;
  }

  /* A second, smaller frame overlapping the first. Two photos at honest size
     read as a composition; one photo in the same space reads as a gap that
     needed filling. It sits inside the frame's own box so it can never push
     the page wider — the overlap is achieved with the offset below, not by
     spilling into the copy column. */
  .photo-hero-inset {
    position: absolute;
    left: -1.75rem;
    bottom: 2.25rem;
    z-index: 2;
    width: 42%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
    border: 3px solid var(--black);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.5);
  }

  .photo-hero-inset img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .photo-hero-frame figcaption {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: var(--space-2xs) 0 0;
    color: var(--on-dark-faint);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .photo-hero-tag {
    padding: 0.15rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--accent-bright) 55%, transparent);
    border-radius: 2px;
    color: var(--accent-bright);
    letter-spacing: var(--tracking-label);
  }

  @media (max-width: 900px) {
    .photo-hero {
      padding: var(--space-xl) 0 var(--space-2xl);
    }

    .photo-hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }

    .photo-hero-copy h1 {
      max-width: none;
    }

    .photo-hero-plate {
      aspect-ratio: 5 / 4;
    }

    .photo-hero-plate img {
      object-position: 52% 34%;
    }

    /* Dropped on phones rather than shrunk. The hero is already tall there,
       and lazy + display:none means the file is never fetched. */
    .photo-hero-inset {
      display: none;
    }

    .trust-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-strip li:nth-child(odd) {
      padding-left: 0;
    }

    .trust-strip li:nth-child(2n) {
      border-right: 0;
      padding-left: var(--space-s);
    }

    .trust-strip li:nth-child(n + 3) {
      border-top: 1px solid var(--dark-line);
      margin-top: var(--space-2xs);
    }
  }

  /* Large text on a phone: two columns of "Clearview" / "replacement & new construction" no longer
     fit (at 200% the second column ran 36px past the hero and was clipped). Stack the four claims
     once the strip is under 16rem wide: a 390px phone at 150% text or more. */
  @container (max-width: 16rem) {
    .trust-strip {
      grid-template-columns: minmax(0, 1fr);
    }

    .trust-strip li,
    .trust-strip li:nth-child(2n),
    .trust-strip li:nth-child(n + 3) {
      border-right: 0;
      border-top: 1px solid var(--dark-line);
      margin-top: 0;
      padding: var(--space-xs) 0;
    }

    .trust-strip li:first-child {
      border-top: 0;
    }
  }
</style>
