---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { dimensionsOf } from '../lib/image-sizes';
interface Props { image: ImageMetadata; title: string; alt: string; detail: string; photo?: boolean; small?: boolean; }
const { image, title, alt, detail, photo = false, small = false } = Astro.props;
const nativeWidth = dimensionsOf(image).width;
const thumbWidth = Math.min(nativeWidth, small ? 160 : 640);
const widths = [...new Set([160, 320, thumbWidth].filter(w => w <= thumbWidth))];
const full = await getImage({ src: image, width: Math.min(nativeWidth, 1600), format: 'webp', quality: 90 });
---
<figure class:list={['media-card', { 'is-photo': photo, 'is-small': small }]}>
  <a class="media-image" href={full.src} target="_blank" rel="noopener noreferrer" aria-label={`Enlarge ${title} (opens image in a new tab)`}>
    <Image src={image} alt={alt} width={thumbWidth} widths={widths} sizes={small ? '100px' : '(max-width: 600px) calc(100vw - 96px), (max-width: 1000px) 40vw, 360px'} format="webp" quality={85} loading="lazy" decoding="async" />
    <span class="enlarge" aria-hidden="true">Enlarge ↗</span>
  </a>
  <figcaption><strong>{title}</strong><p>{detail}</p></figcaption>
</figure>
<style>
  .media-card { margin: 0; min-width: 0; background: var(--paper-raised); border: 1px solid var(--line); }
  .media-image { display: grid; grid-template-columns: minmax(0, 1fr); place-items: center; position: relative; min-height: 230px; padding: var(--space-s); background: var(--paper-raised); }
  .media-image img { width: 100%; height: 210px; object-fit: contain; }
  .media-image:hover { background: var(--accent-wash); }
  .enlarge { position: absolute; right: var(--space-xs); bottom: var(--space-xs); background: var(--paper-raised); border: 1px solid var(--line); padding: var(--space-3xs) var(--space-2xs); color: var(--accent-ink); font-size: var(--step--2); }
  figcaption { padding: var(--space-s); }
  strong { font-size: var(--step-0); }
  p { color: var(--ink-soft); font-size: var(--step--1); margin: var(--space-2xs) 0 0; }
  .is-small .media-image { min-height: 160px; }
  .is-small .media-image img { width: auto; max-width: 100px; height: auto; max-height: 100px; }
  .is-photo .media-image { padding: 0; }
  .is-photo .media-image img { height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
</style>
