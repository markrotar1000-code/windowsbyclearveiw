---
import CanvaGuideEmbed from '../CanvaGuideEmbed.astro';
import flashingGraphic from '../../assets/guides/window-flashing-water-way-out.png';

interface Props { heading?: string | null; }
const { heading = 'Window flashing: give water a way out.' } = Astro.props;
---
<div class="flashing-order">
  {heading && <h3 class="flashing-heading">{heading}</h3>}
  <CanvaGuideEmbed
    desktopSrc={flashingGraphic}
    widths={[1000, 1400, 1536]}
    alt="Window Flashing: Give Water a Way Out. A flanged window in a wall, with the siding cut away to show the layers: 1 the sill pan collects incidental water and directs it outside; 2 side flashing overlaps the sill flashing at both lower corners; 3 head flashing overlaps the side flashing above the window; 4 the upper housewrap laps over the head flashing. Three details below: at the sill, preserve the drainage path; at the head, upper layers shed onto lower layers; inside the opening, air sealing is a separate interior detail. A good installation manages water outside and seals air leaks inside."
    title="Window flashing: how the layers overlap"
    description="Conceptual flanged window example. Follow the window and flashing manufacturers’ instructions for the actual wall assembly."
  />
</div>
<style>
  .flashing-heading{margin:0 0 var(--space-s);font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}
</style>
